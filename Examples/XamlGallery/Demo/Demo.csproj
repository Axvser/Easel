<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The media pages use WPF MediaPlayer/MediaElement; the Easel XAML files are AdditionalFiles, not WPF
         Page items, so the WPF default XAML items are disabled. -->
    <UseWPF>true</UseWPF>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>Demo</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Media\*.mp3" />
    <EmbeddedResource Include="Assets\Media\*.mp4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The XAML views take their base types from Easel; the implicit WinForms
         namespace would make Control/UserControl/Panel ambiguous in those files. Every other file
         imports it explicitly. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- The gallery always builds against the Easel source projects in this repository. -->
    <ProjectReference Include="..\..\..\Src\Easel\Easel.csproj" />
    <ProjectReference Include="..\..\..\Src\Generators\Easel.Generator\Easel.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The gallery is a demo: the MVVM helpers track the latest published VeloxDev packages. Animation is
         Easel's own engine, so no VeloxDev adapter package is referenced. -->
    <PackageReference Include="VeloxDev.Core" Version="*" />
    <PackageReference Include="VeloxDev.Core.Generator" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="**/*.xaml" />
  </ItemGroup>
</Project>
