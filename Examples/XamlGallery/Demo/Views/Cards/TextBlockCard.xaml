<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.TextBlockCard"
    Spacing="8">

  <TextBlock Text="Heading" Foreground="{StaticResource Accent}" FontSize="18" />
  <TextBlock Text="Body text uses the theme foreground colour." Foreground="{StaticResource Text}" />
  <TextBlock Text="A wrapped paragraph keeps flowing inside the available width, and the desired height includes every line."
             Width="420"
             Foreground="{StaticResource MutedText}"
             Wrap="True" />

</local:ThemedStackPanel>
