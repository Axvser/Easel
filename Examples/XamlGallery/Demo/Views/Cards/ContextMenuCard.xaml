<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.ContextMenuCard"
    Spacing="10">

  <Button x:Name="openButton" Text="Open context menu" Height="32" Click="OnOpenMenuClick" />

  <TextBlock x:Name="menuStatus" Text="Context menu closed" Foreground="{StaticResource Muted}" />

</local:ThemedStackPanel>
