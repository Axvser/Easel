<local:ThemedDockPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.VirtualizingStackCard"
    Background="{StaticResource Surface}"
    Width="540"
    LastChildFill="True">

  <Border DockPanel.Dock="Top"
          Background="{StaticResource Surface}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="0,0,0,1"
          Padding="18,12">
    <StackPanel Spacing="3">
      <TextBlock Text="VirtualizingStackPanel" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="The concrete one-dimensional layout used directly — no subclass, no custom panel. Only the visible window exists; the base engine pools the rest."
                 Foreground="{StaticResource Muted}"
                 FontSize="9"
                 Wrap="True" />
    </StackPanel>
  </Border>

  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="16,10,16,0">
    <Button Text="Top" Height="28" Click="OnTop" />
    <Button Text="Middle" Height="28" Click="OnMiddle" />
    <Button Text="Bottom" Height="28" Click="OnBottom" />
    <Border Background="{StaticResource Raised}" CornerRadius="7" Padding="9,4" Margin="8,0,0,0">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock x:Name="firstText" Foreground="{StaticResource Muted}" FontSize="8" VerticalAlignment="Center" />
        <TextBlock x:Name="realizedText" Foreground="{StaticResource Signal}" FontSize="8" VerticalAlignment="Center" />
        <TextBlock x:Name="totalText" Foreground="{StaticResource Muted}" FontSize="8" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </StackPanel>

  <ScrollViewer x:Name="viewer" Margin="16,10,16,16" Height="330" HorizontalScrollBarVisibility="Disabled">
    <VirtualizingStackPanel x:Name="panel" ItemsSource="{Binding Rows}" ItemExtent="28">
      <VirtualizingStackPanel.ItemTemplate>
        <DataTemplate>
          <Border Background="{StaticResource Raised}" CornerRadius="4" Padding="10,0" Margin="0,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62" />
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="64" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Number}" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{Binding LevelBrush}" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{StaticResource Text}" FontSize="9" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="{Binding Elapsed}" Foreground="{StaticResource Muted}" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </DataTemplate>
      </VirtualizingStackPanel.ItemTemplate>
    </VirtualizingStackPanel>
  </ScrollViewer>

</local:ThemedDockPanel>
