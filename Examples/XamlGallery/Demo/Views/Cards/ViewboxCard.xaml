<local:ThemedUserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.ViewboxCard">

  <Viewbox Width="260" Height="120">
    <Border Width="400"
            Height="200"
            Background="{StaticResource SurfaceAlt}"
            BorderBrush="{StaticResource Accent}"
            BorderThickness="2"
            CornerRadius="12"
            Padding="16">
      <TextBlock Text="Design at 400×200" Foreground="{StaticResource Text}" FontSize="16" />
    </Border>
  </Viewbox>

</local:ThemedUserControl>
