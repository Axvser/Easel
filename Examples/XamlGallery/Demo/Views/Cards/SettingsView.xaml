<local:ThemedDockPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.Cards.SettingsView"
    Background="{StaticResource Surface}"
    Width="540"
    LastChildFill="True">

  <Border DockPanel.Dock="Top"
          Background="{StaticResource Surface}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="0,0,0,1"
          Padding="18,12"
          Margin="0,0,0,14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Spacing="3">
        <TextBlock Text="Workspace settings" Foreground="{StaticResource Text}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Two-way bindings write straight back into the view model."
                   Foreground="{StaticResource Muted}"
                   FontSize="10"
                   Wrap="True" />
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Accent}" FontSize="9" Wrap="True" />
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <Button Text="Save changes" Height="30" Command="{Binding SaveCommand}" />
      </StackPanel>
    </Grid>
  </Border>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14" Width="540" HorizontalAlignment="Center">

      <Border Background="{StaticResource Surface}"
              BorderBrush="{StaticResource Border}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="Notifications" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="Desktop notifications" Foreground="{StaticResource Text}" FontSize="12" />
              <TextBlock Text="Show a toast when a long capture or export finishes."
                         Foreground="{StaticResource Muted}"
                         FontSize="9"
                         Wrap="True"
                         Width="400" />
            </StackPanel>
            <CheckBox Grid.Column="1"
                      IsChecked="{Binding Notifications, Mode=TwoWay}"
                      VerticalAlignment="Center" />
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="Auto-save the edited properties" Foreground="{StaticResource Text}" FontSize="12" />
              <TextBlock Text="Writes inspector changes to the selected card immediately."
                         Foreground="{StaticResource Muted}"
                         FontSize="9" />
            </StackPanel>
            <CheckBox Grid.Column="1"
                      IsChecked="{Binding AutoSave, Mode=TwoWay}"
                      VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource Surface}"
              BorderBrush="{StaticResource Border}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="Audio" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" />
          <StackPanel Spacing="6">
            <Grid>
              <TextBlock Text="Preview volume" Foreground="{StaticResource Text}" FontSize="12" />
              <TextBlock Text="{Binding Volume, StringFormat=F0}"
                         Foreground="{StaticResource Accent}"
                         FontSize="12"
                         HorizontalAlignment="Right" />
            </Grid>
            <Slider Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay}" />
          </StackPanel>
          <ProgressBar Height="8" Value="{Binding Volume}" />
        </StackPanel>
      </Border>

      <Border Background="{StaticResource Surface}"
              BorderBrush="{StaticResource Border}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="Account" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" />
          <StackPanel Spacing="4">
            <TextBlock Text="Display name" Foreground="{StaticResource Muted}" FontSize="9" />
            <TextBox Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Password" Foreground="{StaticResource Muted}" FontSize="9" />
            <TextBox IsPassword="True" Text="hunter2-visual" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Text="Editor density" Foreground="{StaticResource Muted}" FontSize="9" />
            <StackPanel Orientation="Horizontal" Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <RadioButton GroupName="density" IsChecked="True" />
                <TextBlock Text="Comfortable" Foreground="{StaticResource Text}" FontSize="10" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <RadioButton GroupName="density" />
                <TextBlock Text="Compact" Foreground="{StaticResource Text}" FontSize="10" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <RadioButton GroupName="density" />
                <TextBlock Text="Dense" Foreground="{StaticResource Text}" FontSize="10" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Text="Language" Foreground="{StaticResource Muted}" FontSize="9" />
            <ComboBox x:Name="language" Width="240" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource DeepGradient}" CornerRadius="12" Padding="16">
        <StackPanel Spacing="4">
          <TextBlock Text="Every field above is a binding." Foreground="{StaticResource AccentText}" FontSize="12" FontWeight="SemiBold" />
          <TextBlock Text="The page declares controls and bindings; SettingsViewModel owns the values and the SaveCommand. No control is created in C#."
                     Foreground="{StaticResource AccentText}"
                     FontSize="9"
                     Wrap="True" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</local:ThemedDockPanel>
