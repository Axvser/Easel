<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.DynamicResourceCard"
    Spacing="10">

  <TextBlock Text="The left swatch uses DynamicResource and repaints when this view's dictionary changes. The right one uses StaticResource and keeps its first value."
             Foreground="{StaticResource Muted}"
             Wrap="True"
             Width="480" />

  <StackPanel Orientation="Horizontal" Spacing="14">
    <StackPanel Spacing="4">
      <Border Width="160" Height="64" CornerRadius="10" Background="{DynamicResource Accent}" />
      <TextBlock Text="DynamicResource" Foreground="{StaticResource Text}" FontSize="9" />
    </StackPanel>
    <StackPanel Spacing="4">
      <Border Width="160" Height="64" CornerRadius="10" Background="{StaticResource Accent}" />
      <TextBlock Text="StaticResource" Foreground="{StaticResource Text}" FontSize="9" />
    </StackPanel>
  </StackPanel>

  <StackPanel Orientation="Horizontal" Spacing="8">
    <Button Text="Change Accent" Height="30" Click="OnChangeClicked" />
    <Button Text="Reset theme" Height="30" Click="OnResetClicked" />
  </StackPanel>

  <TextBlock x:Name="status"
             Text="The theme dictionary supplies Accent."
             Foreground="{StaticResource Accent}"
             FontSize="9"
             Wrap="True" />

</local:ThemedStackPanel>
