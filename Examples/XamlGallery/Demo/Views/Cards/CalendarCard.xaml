<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.CalendarCard"
    Width="600"
    Spacing="8">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Spacing="2">
      <TextBlock Text="Release calendar"
                 Foreground="{StaticResource Text}"
                 FontSize="18"
                 FontWeight="SemiBold" />
      <TextBlock Text="A month grid drawn by GDI+; the accent marks the selected day"
                 Foreground="{StaticResource Muted}"
                 FontSize="9" />
    </StackPanel>

    <Border Grid.Column="1"
            Background="{StaticResource SurfaceAlt}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8,4"
            VerticalAlignment="Center">
      <TextBlock Text="GDI+ MONTH GRID" Foreground="{StaticResource Muted}" FontSize="8" />
    </Border>
  </Grid>

  <Grid Height="348">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="360" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Viewbox Grid.Column="0"
             Width="360"
             Height="348"
             Stretch="Uniform">
      <Calendar x:Name="calendar"
                Width="250"
                Height="226"
                SelectedDateChanged="OnSelectedDateChanged" />
    </Viewbox>

    <StackPanel Grid.Column="1" Margin="16,4,0,0" Spacing="8">
      <TextBlock Text="MONTH VIEW" Foreground="{StaticResource Accent}" FontSize="8" FontWeight="SemiBold" />
      <TextBlock Text="The grid is scaled by a Viewbox here so the demo fills the card; the control itself keeps its 250×226 design size."
                 Foreground="{StaticResource Muted}"
                 FontSize="9"
                 Wrap="True" />
      <Border Background="{StaticResource SurfaceAlt}"
              BorderBrush="{StaticResource Border}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="10,7">
        <StackPanel Spacing="2">
          <TextBlock Text="SELECTED" Foreground="{StaticResource Muted}" FontSize="8" />
          <TextBlock x:Name="status" Text="—" Foreground="{StaticResource Text}" FontSize="12" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
      <TextBlock Text="Arrow keys move by day; PageUp/PageDown move by month. Only the selected day gets the accent fill."
                 Foreground="{StaticResource Muted}"
                 FontSize="9"
                 Wrap="True" />
    </StackPanel>
  </Grid>

</local:ThemedStackPanel>
