<local:ThemedBorder
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.NativePopupBody"
    Width="250"
    Padding="12"
    Background="{StaticResource SurfaceAlt}"
    BorderBrush="{StaticResource Border}"
    BorderThickness="1"
    CornerRadius="8">

  <StackPanel Spacing="6">
    <TextBlock Text="Over a native island" Foreground="{StaticResource Accent}" FontSize="12" />
    <TextBlock
        Text="This popup is drawn by the surface overlay. The island's window region is cut so the popup shows through instead of being covered by the HWND."
        Foreground="{StaticResource Text}"
        Wrap="True" />
  </StackPanel>

</local:ThemedBorder>
