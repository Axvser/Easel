<local:ThemedBorder
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.PopupBodyView"
    Width="240"
    Padding="14"
    Background="{StaticResource SurfaceAlt}"
    BorderBrush="{StaticResource Border}"
    BorderThickness="1"
    CornerRadius="8">

  <StackPanel Spacing="6">
    <TextBlock Text="Overlay popup" Foreground="{StaticResource Accent}" FontSize="12" />
    <TextBlock Text="The popup escapes ancestor clips and hit-tests before the root tree."
               Foreground="{StaticResource Text}"
               Wrap="True" />
  </StackPanel>

</local:ThemedBorder>
