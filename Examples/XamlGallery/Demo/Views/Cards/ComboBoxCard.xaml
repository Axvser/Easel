<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.ComboBoxCard"
    Width="600"
    Spacing="10">

  <StackPanel Spacing="2">
    <TextBlock Text="Scheduling policy"
               Foreground="{StaticResource Text}"
               FontSize="18"
               FontWeight="SemiBold" />
    <TextBlock Text="A drop-down that opens in the surface overlay; the list is never clipped by an ancestor"
               Foreground="{StaticResource Muted}"
               FontSize="9" />
  </StackPanel>

  <Border Background="{StaticResource SurfaceAlt}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="1"
          CornerRadius="10"
          Padding="18,16">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="POLICY" Foreground="{StaticResource Muted}" FontSize="8" />
        <ComboBox x:Name="comboBox"
                  Width="320"
                  Height="34"
                  SelectedIndex="0"
                  SelectionChanged="OnSelectionChanged" />
      </StackPanel>

      <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="CURRENT" Foreground="{StaticResource Muted}" FontSize="8" />
        <TextBlock x:Name="status" Text="—" Foreground="{StaticResource Text}" FontSize="14" FontWeight="SemiBold" />
        <TextBlock Text="The short list is a ListBox inside a ScrollViewer inside a VisualPopup; the popup renders above the root tree."
                   Foreground="{StaticResource Muted}"
                   FontSize="9"
                   Wrap="True" />
      </StackPanel>
    </Grid>
  </Border>

  <TextBlock Text="Open the list and press Up/Down; Enter commits, Escape restores the selection captured at open."
             Foreground="{StaticResource Muted}"
             FontSize="9"
             Wrap="True" />

</local:ThemedStackPanel>
