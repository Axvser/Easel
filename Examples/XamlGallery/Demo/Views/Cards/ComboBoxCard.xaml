<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.ComboBoxCard"
    Width="600"
    Spacing="10">

  <StackPanel Spacing="2">
    <TextBlock Text="Scheduling policy"
               Foreground="{StaticResource Text}"
               FontSize="18"
               FontWeight="SemiBold" />
    <TextBlock Text="A drop-down that opens in the surface overlay; the list is never clipped by an ancestor"
               Foreground="{StaticResource Muted}"
               FontSize="9" />
  </StackPanel>

  <Border Background="{StaticResource SurfaceAlt}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="1"
          CornerRadius="10"
          Padding="18,16">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
        <StackPanel Spacing="4">
          <TextBlock Text="POLICY" Foreground="{StaticResource Muted}" FontSize="8" />
          <ComboBox x:Name="comboBox"
                    Width="320"
                    Height="34"
                    SelectedIndex="0"
                    SelectionChanged="OnSelectionChanged" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="EDITABLE" Foreground="{StaticResource Muted}" FontSize="8" />
          <ComboBox x:Name="editableCombo"
                    Width="320"
                    Height="34"
                    IsEditable="True"
                    Placeholder="Type or choose…"
                    Foreground="{StaticResource Accent}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="CURRENT" Foreground="{StaticResource Muted}" FontSize="8" />
        <TextBlock x:Name="status" Text="—" Foreground="{StaticResource Text}" FontSize="14" FontWeight="SemiBold" />
        <TextBlock Text="Hover is neutral; open and focus rings fade in. The editable field uses Placeholder and pushes Foreground to its rows."
                   Foreground="{StaticResource Muted}"
                   FontSize="9"
                   Wrap="True" />
      </StackPanel>
    </Grid>
  </Border>

  <TextBlock Text="Open the list and press Up/Down; Enter commits, Escape restores the selection captured at open."
             Foreground="{StaticResource Muted}"
             FontSize="9"
             Wrap="True" />

</local:ThemedStackPanel>
