<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.StyleResourcesCard"
    Spacing="10">

  <StackPanel.Resources>
    <Style x:Key="AccentPlate" TargetType="Border">
      <Style.Setters>
        <Setter Property="Width" Value="220" />
        <Setter Property="Height" Value="70" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{StaticResource Accent}" />
      </Style.Setters>
    </Style>
  </StackPanel.Resources>

  <Border Style="{StaticResource AccentPlate}" />

  <TextBlock Text="The brush came from the parent's resource dictionary."
             Foreground="{StaticResource Muted}"
             Wrap="True" />

</local:ThemedStackPanel>
