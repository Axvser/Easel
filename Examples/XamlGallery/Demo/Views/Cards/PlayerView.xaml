<local:ThemedDockPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.Cards.PlayerView"
    Background="{StaticResource Surface}"
    Width="540"
    LastChildFill="True">

  <Border DockPanel.Dock="Top"
          Background="{StaticResource Surface}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="0,0,0,1"
          Padding="18,12"
          Margin="0,0,0,16">
    <StackPanel Spacing="3">
      <TextBlock Text="Now playing" Foreground="{StaticResource Text}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="A media page: 3D-tilted artwork, a masked accent strip, transport bindings and a playlist."
                 Foreground="{StaticResource Muted}"
                 FontSize="10"
                 Wrap="True" />
    </StackPanel>
  </Border>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Width="300" Spacing="14" Margin="0,0,20,0">

      <Border Width="260"
              Height="260"
              CornerRadius="18"
              Background="{StaticResource DeepGradient}"
              HorizontalAlignment="Center">
        <Border.Transform3D>
          <Rotate3DTransform AngleX="10" AngleY="-16" CenterX="130" CenterY="130" Depth="700" />
        </Border.Transform3D>
        <Grid>
          <Ellipse Width="150" Height="150" Fill="{StaticResource RadialGlow}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <StackPanel Spacing="4" VerticalAlignment="Bottom" Margin="18">
            <TextBlock Text="AURORA DRIFT" Foreground="{StaticResource AccentText}" FontSize="16" FontWeight="Bold" />
            <TextBlock Text="{Binding Artist}" Foreground="{StaticResource AccentText}" FontSize="10" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Height="10" CornerRadius="5" Background="{StaticResource AuroraGradient}" OpacityMask="{StaticResource FadeMask}" />

      <StackPanel Spacing="4">
        <TextBlock Text="{Binding TrackTitle}" Foreground="{StaticResource Text}" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Artist}" Foreground="{StaticResource Muted}" FontSize="10" />
      </StackPanel>

      <ProgressBar Height="8" Value="{Binding Progress}" />

      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Text="Prev" Height="32" Width="62" Click="OnPrevClicked" />
        <Button Text="{Binding PlayLabel}" Height="32" Width="88" Command="{Binding TogglePlaybackCommand}" />
        <Button Text="Next" Height="32" Width="62" Click="OnNextClicked" />
      </StackPanel>

      <Grid>
        <TextBlock x:Name="positionText" Text="0:00" Foreground="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Left" />
        <TextBlock x:Name="durationText" Text="0:00" Foreground="{StaticResource Muted}" FontSize="9" HorizontalAlignment="Right" />
      </Grid>

      <StackPanel Spacing="4">
        <TextBlock Text="SEEK · embedded MP3" Foreground="{StaticResource Muted}" FontSize="8" />
        <Slider x:Name="seekSlider" Minimum="0" Maximum="100" Value="{Binding Progress}" ValueChanged="OnSeekChanged" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Column="1"
            Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,10">
          <TextBlock Text="Up next" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" />
          <TextBlock Text="Selecting a row updates the title through a two-way binding."
                     Foreground="{StaticResource Muted}"
                     FontSize="9" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Tracks}"
                 SelectedItem="{Binding SelectedTrack, Mode=TwoWay}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="2">
                <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding}" Foreground="{StaticResource Text}" FontSize="11" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>

</local:ThemedDockPanel>
