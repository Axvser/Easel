<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.Cards.AnimationKeyFrameCard"
    Spacing="12">

  <local:ThemedStackPanel.Resources>
    <Style x:Key="KeyFrameSurface" TargetType="Border">
      <Style.Setters>
        <Setter Property="Width" Value="200" />
        <Setter Property="Height" Value="110" />
        <Setter Property="Background" Value="{StaticResource SunsetGradient}" />
        <Setter Property="CornerRadius" Value="10" />
      </Style.Setters>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Trigger.EnterAction>
            <KeyFrameAnimation Property="Width" Duration="0:0:0.9" Ease="CubicInOut">
              <KeyFrame Offset="0" Value="200" />
              <KeyFrame Offset="0.5" Value="120" />
              <KeyFrame Offset="1" Value="280" />
            </KeyFrameAnimation>
          </Trigger.EnterAction>
          <Trigger.ExitAction>
            <TransitionAction Property="Width" To="200" Duration="0:0:0.3" Ease="CubicOut" />
          </Trigger.ExitAction>
        </Trigger>
      </Style.Triggers>
    </Style>
  </local:ThemedStackPanel.Resources>

  <TextBlock Text="A KeyFrameAnimation chains several segments over one duration: the offsets split the time, each segment runs the same easing. The stage is fixed, so the width change moves nothing else."
             Foreground="{StaticResource Muted}"
             Wrap="True" />

  <Border Height="190"
          Background="{StaticResource SurfaceAlt}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="1"
          CornerRadius="10">
    <Grid>
      <Border x:Name="surface"
              Margin="24,0,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Style="{StaticResource KeyFrameSurface}" />
    </Grid>
  </Border>

  <StackPanel Orientation="Horizontal" Spacing="8">
    <Button Text="Start" Height="30" Click="OnStart" />
    <Button Text="Reset" Height="30" Click="OnReset" />
    <TextBlock Text="Width 200 → 120 → 280 over 900 ms, then back to 200 on reset"
               VerticalAlignment="Center"
               Foreground="{StaticResource Muted}"
               FontSize="9" />
  </StackPanel>

  <Border Width="560"
          Background="{StaticResource Raised}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="1"
          CornerRadius="10"
          Padding="14">
    <StackPanel Spacing="3">
      <TextBlock Text="MARKUP" Foreground="{StaticResource Accent}" FontSize="8" />
      <TextBlock Text="&lt;Trigger.EnterAction&gt;&#10;  &lt;KeyFrameAnimation Property=&quot;Width&quot; Duration=&quot;0:0:0.9&quot; Ease=&quot;CubicInOut&quot;&gt;&#10;    &lt;KeyFrame Offset=&quot;0&quot; Value=&quot;200&quot; /&gt;&#10;    &lt;KeyFrame Offset=&quot;0.5&quot; Value=&quot;120&quot; /&gt;&#10;    &lt;KeyFrame Offset=&quot;1&quot; Value=&quot;280&quot; /&gt;&#10;  &lt;/KeyFrameAnimation&gt;&#10;&lt;/Trigger.EnterAction&gt;"
                 Foreground="{StaticResource Text}"
                 FontSize="10"
                 Wrap="True" />
    </StackPanel>
  </Border>

</local:ThemedStackPanel>
