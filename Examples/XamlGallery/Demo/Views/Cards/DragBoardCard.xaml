<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.DragBoardCard"
    Width="760"
    Spacing="12">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Spacing="3">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Drag board"
                   Foreground="{StaticResource Text}"
                   FontSize="20"
                   FontWeight="SemiBold" />
        <Border Background="{StaticResource EmeraldGradient}"
                CornerRadius="8"
                Padding="8,3"
                VerticalAlignment="Center">
          <TextBlock Text="NATIVE OLE DRAG"
                     Foreground="{StaticResource AccentText}"
                     FontSize="8" />
        </Border>
      </StackPanel>
      <TextBlock Text="Drag a row across the gap; the receiving grid removes it from the sender. Files from Explorer land as rows."
                 Foreground="{StaticResource Muted}"
                 FontSize="10" />
    </StackPanel>

    <Border Grid.Column="1"
            Background="{StaticResource SurfaceAlt}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,5"
            VerticalAlignment="Center">
      <TextBlock x:Name="action"
                 Text="Ready"
                 Foreground="{StaticResource Accent}"
                 FontSize="9"
                 FontWeight="SemiBold" />
    </Border>
  </Grid>

  <Grid Height="360">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="30" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <DataGrid x:Name="inbox"
              Grid.Column="0"
              ItemsSource="{Binding InboxRows}"
              RowHeight="32"
              ShowRowNumbers="True"
              SelectionChanged="OnInboxSelectionChanged"
              DragStarting="OnInboxDragStarting"
              Dropped="OnInboxDropped">
      <DataGrid.Columns>
        <DataGridColumn Header="Inbox" BindingPath="Name" Width="0" MinWidth="100" />
        <DataGridColumn Header="Status" BindingPath="Status" Width="88" Kind="Badge" />
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
      <TextBlock Text="↔" Foreground="{StaticResource Muted}" FontSize="16" HorizontalAlignment="Center" />
      <Border Width="1" Height="120" Background="{StaticResource Border}" HorizontalAlignment="Center" />
    </StackPanel>

    <DataGrid x:Name="done"
              Grid.Column="2"
              ItemsSource="{Binding DoneRows}"
              RowHeight="32"
              ShowRowNumbers="True"
              SelectionChanged="OnDoneSelectionChanged"
              DragStarting="OnDoneDragStarting"
              Dropped="OnDoneDropped">
      <DataGrid.Columns>
        <DataGridColumn Header="Done" BindingPath="Name" Width="0" MinWidth="100" />
        <DataGridColumn Header="Status" BindingPath="Status" Width="88" Kind="Badge" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>

  <Grid Height="46">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="INBOX" Foreground="{StaticResource Muted}" FontSize="8" VerticalAlignment="Center" />
        <TextBlock x:Name="inboxStat" Text="—" Foreground="{StaticResource Text}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <Border Grid.Column="1" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="DONE" Foreground="{StaticResource Muted}" FontSize="8" VerticalAlignment="Center" />
        <TextBlock x:Name="doneStat" Text="—" Foreground="{StaticResource Text}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>

  <StackPanel Spacing="4">
    <TextBlock Text="· Rows keep their identity: the same SampleRow object moves between the two ObservableCollections."
               Foreground="{StaticResource Muted}"
               FontSize="9"
               Wrap="True" />
    <TextBlock Text="· A move removes from the source only when the target list is a writable IList; read-only sources fall back to Dropped."
               Foreground="{StaticResource Muted}"
               FontSize="9"
               Wrap="True" />
    <TextBlock Text="· Escape cancels a drag; the floating label and drop line disappear with it."
               Foreground="{StaticResource Muted}"
               FontSize="9"
               Wrap="True" />
  </StackPanel>

</local:ThemedStackPanel>
