<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.ProgressCard"
    Spacing="12">

  <ProgressBar x:Name="bar" Width="240" Height="10" Maximum="100" />
  <Slider x:Name="slider" Width="240" Maximum="100" Value="65" />

  <TextBlock Text="The bar follows the slider through a one-way visual binding."
             Foreground="{StaticResource Muted}" />

</local:ThemedStackPanel>
