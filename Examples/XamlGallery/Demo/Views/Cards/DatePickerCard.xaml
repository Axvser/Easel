<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.DatePickerCard"
    Width="600"
    Spacing="10">

  <StackPanel Spacing="2">
    <TextBlock Text="Delivery date"
               Foreground="{StaticResource Text}"
               FontSize="18"
               FontWeight="SemiBold" />
    <TextBlock Text="A typed date field whose Calendar opens in the surface overlay, not inside the card"
               Foreground="{StaticResource Muted}"
               FontSize="9" />
  </StackPanel>

  <Border Background="{StaticResource SurfaceAlt}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="1"
          CornerRadius="10"
          Padding="18,16">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="SHIP ON" Foreground="{StaticResource Muted}" FontSize="8" />
        <DatePicker x:Name="datePicker"
                    Width="300"
                    Height="34"
                    SelectedDateChanged="OnSelectedDateChanged" />
      </StackPanel>

      <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="SELECTED" Foreground="{StaticResource Muted}" FontSize="8" />
        <TextBlock x:Name="status" Text="—" Foreground="{StaticResource Text}" FontSize="14" FontWeight="SemiBold" />
        <TextBlock Text="Format, Placeholder and SelectedDate are dependency properties; the dropdown is a VisualPopup above the root tree."
                   Foreground="{StaticResource Muted}"
                   FontSize="9"
                   Wrap="True" />
      </StackPanel>
    </Grid>
  </Border>

  <TextBlock Text="Open the picker and choose another day: the popup is not clipped by the card or by the preview ScrollViewer."
             Foreground="{StaticResource Muted}"
             FontSize="9"
             Wrap="True" />

</local:ThemedStackPanel>
