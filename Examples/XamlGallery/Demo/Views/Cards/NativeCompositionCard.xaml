<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.NativeCompositionCard"
    Spacing="9">

  <TextBlock
      Text="A live HWND can only be clipped by a window region (binary, its native border cut at the corners) — the plain button below. IsSnapshot paints the bitmap, clips it to an anti-aliased rounded path and draws the visual border; the popup is drawn by the overlay and the island's region is cut around it."
      Width="420"
      HorizontalAlignment="Left"
      Foreground="{StaticResource Muted}"
      Wrap="True" />

  <native:Button
      x:Name="rounded"
      Text="Rounded snapshot"
      Width="240"
      Height="32"
      IsSnapshot="True"
      CornerRadius="14"
      BorderBrush="{StaticResource Accent}"
      BorderThickness="1"
      HorizontalAlignment="Left" />

  <native:Button
      x:Name="liveRounded"
      Text="Live region (cut corners)"
      Width="240"
      Height="32"
      CornerRadius="14"
      HorizontalAlignment="Left" />

  <native:Button
      x:Name="faded"
      Text="Snapshot at 55%"
      Width="240"
      Height="32"
      IsSnapshot="True"
      Opacity="0.55"
      HorizontalAlignment="Left" />

  <native:Button
      x:Name="rotated"
      Text="Rotated snapshot"
      Width="200"
      Height="32"
      IsSnapshot="True"
      Margin="0,22,0,22"
      HorizontalAlignment="Left" />

  <Button
      x:Name="showPopupButton"
      Text="Open over the island"
      Width="200"
      Height="30"
      HorizontalAlignment="Left"
      Click="OnShowPopupClick" />

  <native:GroupBox
      x:Name="island"
      Text="Native island"
      Width="320"
      Height="108"
      Margin="0,10,0,0"
      HorizontalAlignment="Left">
    <StackPanel Spacing="4">
      <TextBlock Text="This visual StackPanel lives inside the native GroupBox." Wrap="True" />
      <TextBlock
          Text="The popup above is painted by the overlay; the island's window region is cut so it shows through."
          Foreground="{StaticResource Muted}"
          Wrap="True" />
    </StackPanel>
  </native:GroupBox>

</local:ThemedStackPanel>
