<local:ThemedUserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.CanvasCard">

  <local:ThemedUserControl.Resources>
    <Style x:Key="Tile" TargetType="Border">
      <Style.Setters>
        <Setter Property="Width" Value="90" />
        <Setter Property="Height" Value="54" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8" />
      </Style.Setters>
    </Style>
    <Style x:Key="TileText" TargetType="TextBlock">
      <Style.Setters>
        <Setter Property="Foreground" Value="{StaticResource AccentText}" />
        <Setter Property="TextAlignment" Value="Center" />
      </Style.Setters>
    </Style>
  </local:ThemedUserControl.Resources>

  <Canvas Width="420" Height="170" Background="{StaticResource SurfaceAlt}">
    <Border Canvas.Left="30" Canvas.Top="30" Style="{StaticResource Tile}" Background="{StaticResource Accent}">
      <TextBlock Style="{StaticResource TileText}" Text="Left/Top" />
    </Border>
    <Border Canvas.Left="190" Canvas.Top="90" Style="{StaticResource Tile}" Background="{StaticResource Focus}">
      <TextBlock Style="{StaticResource TileText}" Text="Right/Bottom" />
    </Border>
  </Canvas>

</local:ThemedUserControl>
