<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.Cards.CompositionCard"
    Spacing="12">

  <TextBlock Text="A lightweight Visual tree composed through group opacity, an opacity mask, a drop shadow and a bitmap cache."
             Foreground="{StaticResource Muted}"
             Wrap="True" />

  <StackPanel Orientation="Horizontal" Spacing="16">
    <Border Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10">
      <VisualPresenter x:Name="compositionPresenter" Width="240" Height="150">
        <VisualPresenter.Content>
          <ContainerVisual Opacity="0.85">
            <ContainerVisual.Children>
              <ShapeVisual Bounds="10,10,96,96" Fill="{StaticResource Accent}" Opacity="0.85" CacheAsBitmap="True">
                <ShapeVisual.Geometry>
                  <EllipseGeometry />
                </ShapeVisual.Geometry>
              </ShapeVisual>
              <ShapeVisual Bounds="72,28,120,100" Fill="{StaticResource Selection}" Opacity="0.7">
                <ShapeVisual.Geometry>
                  <RectangleGeometry RadiusX="16" RadiusY="16" />
                </ShapeVisual.Geometry>
                <ShapeVisual.Effect>
                  <DropShadowEffect Offset="6,8" Blur="10" Color="#80000000" Opacity="0.55" />
                </ShapeVisual.Effect>
              </ShapeVisual>
              <TextVisual Bounds="0,124,240,22" Text="Composed visual tree" Foreground="{StaticResource Text}" />
            </ContainerVisual.Children>
          </ContainerVisual>
        </VisualPresenter.Content>
      </VisualPresenter>
    </Border>

    <Border Width="200"
            Height="150"
            CornerRadius="10"
            Background="{StaticResource AccentGradient}"
            OpacityMask="{StaticResource FadeMask}"
            Padding="14">
      <TextBlock Text="Opacity mask" Foreground="White" VerticalAlignment="Bottom" />
    </Border>
  </StackPanel>

</local:ThemedStackPanel>
