<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.TwoWayBindingCard"
    Spacing="8">

  <TextBox Width="320"
           Text="{Binding OptionalName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

  <TextBlock Text="{Binding OptionalName, StringFormat='Source: {0}'}"
             Foreground="{StaticResource Muted}" />

</local:ThemedStackPanel>
