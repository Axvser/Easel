<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.StackPanelCard"
    Orientation="Horizontal"
    Spacing="10">

  <local:ThemedStackPanel.Resources>
    <Style x:Key="Tile" TargetType="Border">
      <Style.Setters>
        <Setter Property="Width" Value="90" />
        <Setter Property="Height" Value="54" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8" />
      </Style.Setters>
    </Style>
    <Style x:Key="TileText" TargetType="TextBlock">
      <Style.Setters>
        <Setter Property="Foreground" Value="{StaticResource AccentText}" />
        <Setter Property="TextAlignment" Value="Center" />
      </Style.Setters>
    </Style>
  </local:ThemedStackPanel.Resources>

  <Border Style="{StaticResource Tile}" Background="{StaticResource Accent}">
    <TextBlock Style="{StaticResource TileText}" Text="One" />
  </Border>
  <Border Style="{StaticResource Tile}" Background="{StaticResource Focus}">
    <TextBlock Style="{StaticResource TileText}" Text="Two" />
  </Border>
  <Border Style="{StaticResource Tile}" Background="{StaticResource Focus}">
    <TextBlock Style="{StaticResource TileText}" Text="Three" />
  </Border>

</local:ThemedStackPanel>
