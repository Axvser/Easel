<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.Cards.Transform3DCard"
    Spacing="14">

  <TextBlock Text="Rotate3DTransform projects live 2D cards in perspective; the sliders drive the angles through dependency properties."
             Foreground="{StaticResource Muted}"
             Wrap="True" />

  <StackPanel Orientation="Horizontal" Spacing="26">
    <Border x:Name="liveCard"
            Width="170"
            Height="130"
            CornerRadius="12"
            Padding="14"
            CacheAsBitmap="True"
            Background="{StaticResource AuroraGradient}">
      <Border.Transform3D>
        <Rotate3DTransform AngleX="18" AngleY="28" CenterX="85" CenterY="65" Depth="600" />
      </Border.Transform3D>
      <StackPanel Spacing="6">
        <TextBlock Text="Live tilt" Foreground="White" FontSize="14" FontWeight="SemiBold" />
        <TextBlock x:Name="tiltReadout"
                   Text="AngleX 18 · AngleY 28"
                   Foreground="White"
                   FontSize="9"
                   Wrap="True" />
      </StackPanel>
    </Border>

    <Border Width="170"
            Height="130"
            CornerRadius="12"
            Padding="14"
            Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1">
      <Border.Transform3D>
        <Rotate3DTransform AngleX="16" AngleY="-24" CenterX="85" CenterY="65" Depth="600" />
      </Border.Transform3D>
      <StackPanel Spacing="6">
        <TextBlock Text="Static tilt" Foreground="{StaticResource Text}" FontSize="14" FontWeight="SemiBold" />
        <TextBlock Text="AngleY -24" Foreground="{StaticResource Muted}" FontSize="9" />
      </StackPanel>
    </Border>

    <Border Width="170"
            Height="130"
            CornerRadius="12"
            Padding="14"
            Background="{StaticResource DeepGradient}">
      <Border.Transform3D>
        <Rotate3DTransform AngleX="-12" AngleY="16" AngleZ="8" CenterX="85" CenterY="65" Depth="600" />
      </Border.Transform3D>
      <StackPanel Spacing="6">
        <TextBlock Text="Gradient card" Foreground="White" FontSize="14" FontWeight="SemiBold" />
        <TextBlock Text="AngleX -12 · AngleY 16" Foreground="White" FontSize="9" />
      </StackPanel>
    </Border>
  </StackPanel>

  <StackPanel Spacing="6" Width="280">
    <TextBlock Text="AngleX" Foreground="{StaticResource Muted}" FontSize="9" />
    <Slider x:Name="angleX" Minimum="-60" Maximum="60" Value="18" ValueChanged="OnTiltChanged" />
    <TextBlock Text="AngleY" Foreground="{StaticResource Muted}" FontSize="9" />
    <Slider x:Name="angleY" Minimum="-60" Maximum="60" Value="28" ValueChanged="OnTiltChanged" />
  </StackPanel>

</local:ThemedStackPanel>
