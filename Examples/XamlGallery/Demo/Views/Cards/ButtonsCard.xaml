<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.ButtonsCard"
    Spacing="10">

  <StackPanel Orientation="Horizontal" Spacing="10">
    <Button Text="Run" Height="32" Click="OnRunClick" />
    <RepeatButton Text="Repeat" Height="32" Click="OnRepeatClick" />
  </StackPanel>

  <TextBlock x:Name="status"
             Text="No clicks yet"
             Foreground="{StaticResource Muted}" />

</local:ThemedStackPanel>
