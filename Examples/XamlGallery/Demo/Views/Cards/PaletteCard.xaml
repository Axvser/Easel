<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.PaletteCard"
    Orientation="Horizontal"
    Spacing="8">

  <Border Padding="8" Background="{StaticResource Surface}" CornerRadius="6">
    <StackPanel Spacing="4">
      <Border Width="54" Height="28" Background="{StaticResource Window}" CornerRadius="4" />
      <TextBlock Text="Window" Foreground="{StaticResource Muted}" />
    </StackPanel>
  </Border>

  <Border Padding="8" Background="{StaticResource Surface}" CornerRadius="6">
    <StackPanel Spacing="4">
      <Border Width="54" Height="28" Background="{StaticResource Surface}" CornerRadius="4" />
      <TextBlock Text="Surface" Foreground="{StaticResource Muted}" />
    </StackPanel>
  </Border>

  <Border Padding="8" Background="{StaticResource Surface}" CornerRadius="6">
    <StackPanel Spacing="4">
      <Border Width="54" Height="28" Background="{StaticResource Raised}" CornerRadius="4" />
      <TextBlock Text="Raised" Foreground="{StaticResource Muted}" />
    </StackPanel>
  </Border>

  <Border Padding="8" Background="{StaticResource Surface}" CornerRadius="6">
    <StackPanel Spacing="4">
      <Border Width="54" Height="28" Background="{StaticResource Accent}" CornerRadius="4" />
      <TextBlock Text="Accent" Foreground="{StaticResource Muted}" />
    </StackPanel>
  </Border>

  <Border Padding="8" Background="{StaticResource Surface}" CornerRadius="6">
    <StackPanel Spacing="4">
      <Border Width="54" Height="28" Background="{StaticResource Selection}" CornerRadius="4" />
      <TextBlock Text="Selection" Foreground="{StaticResource Muted}" />
    </StackPanel>
  </Border>

  <Border Padding="8" Background="{StaticResource Surface}" CornerRadius="6">
    <StackPanel Spacing="4">
      <Border Width="54" Height="28" Background="{StaticResource Focus}" CornerRadius="4" />
      <TextBlock Text="Focus" Foreground="{StaticResource Muted}" />
    </StackPanel>
  </Border>

  <Border Padding="8" Background="{StaticResource Surface}" CornerRadius="6">
    <StackPanel Spacing="4">
      <Border Width="54" Height="28" Background="{StaticResource Border}" CornerRadius="4" />
      <TextBlock Text="Border" Foreground="{StaticResource Muted}" />
    </StackPanel>
  </Border>

  <Border Padding="8" Background="{StaticResource Surface}" CornerRadius="6">
    <StackPanel Spacing="4">
      <Border Width="54" Height="28" Background="{StaticResource Text}" CornerRadius="4" />
      <TextBlock Text="Text" Foreground="{StaticResource Muted}" />
    </StackPanel>
  </Border>

</local:ThemedStackPanel>
