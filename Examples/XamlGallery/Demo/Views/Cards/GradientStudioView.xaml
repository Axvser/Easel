<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.Cards.GradientStudioView"
    Spacing="14">

  <StackPanel Spacing="3">
    <TextBlock Text="Gradient studio" Foreground="{StaticResource Text}" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Text="The same Brush contract WPF uses: linear and radial gradients declared inline, as resources, and painted into borders, text, shapes and masks."
               Foreground="{StaticResource Muted}"
               FontSize="10"
               Wrap="True"
               Width="540" />
  </StackPanel>

  <Border Width="540"
          Height="150"
          CornerRadius="14"
          Padding="20">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <LinearGradientBrush.GradientStops>
          <GradientStop Color="#FF00D2FF" Offset="0" />
          <GradientStop Color="#FF0072FF" Offset="0.5" />
          <GradientStop Color="#FF7B2FF7" Offset="1" />
        </LinearGradientBrush.GradientStops>
      </LinearGradientBrush>
    </Border.Background>
    <StackPanel Spacing="6" VerticalAlignment="Center">
      <TextBlock Text="Inline LinearGradientBrush" Foreground="{StaticResource AccentText}" FontSize="18" FontWeight="Bold" />
      <TextBlock Text="StartPoint=&quot;0,0&quot; · EndPoint=&quot;1,1&quot; · three GradientStops"
                 Foreground="{StaticResource AccentText}"
                 FontSize="10" />
    </StackPanel>
  </Border>

  <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
    <Border Width="125" Height="86" CornerRadius="10" Background="{StaticResource SunsetGradient}">
      <TextBlock Text="Sunset" Foreground="{StaticResource AccentText}" FontSize="10" VerticalAlignment="Bottom" Margin="10" />
    </Border>
    <Border Width="125" Height="86" CornerRadius="10" Background="{StaticResource AuroraGradient}">
      <TextBlock Text="Aurora" Foreground="{StaticResource AccentText}" FontSize="10" VerticalAlignment="Bottom" Margin="10" />
    </Border>
    <Border Width="125" Height="86" CornerRadius="10" Background="{StaticResource EmeraldGradient}">
      <TextBlock Text="Emerald" Foreground="{StaticResource AccentText}" FontSize="10" VerticalAlignment="Bottom" Margin="10" />
    </Border>
    <Border Width="125" Height="86" CornerRadius="10" Background="{StaticResource RadialGlow}">
      <TextBlock Text="Radial glow" Foreground="{StaticResource AccentText}" FontSize="10" VerticalAlignment="Bottom" Margin="10" />
    </Border>
  </StackPanel>

  <Grid Width="540" Height="130">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0"
            Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16"
            Margin="0,0,12,0">
      <StackPanel Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Gradient text" Foreground="{StaticResource TextSpectrumGradient}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Left" />
        <TextBlock Text="Foreground accepts any Brush, not just a colour." Foreground="{StaticResource Muted}" FontSize="9" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Ellipse Width="44" Height="44">
            <Ellipse.Fill>
              <RadialGradientBrush Center="0.38,0.34" Radius="0.62">
                <RadialGradientBrush.GradientStops>
                  <GradientStop Color="#FFFFE29F" Offset="0" />
                  <GradientStop Color="#FFFF512F" Offset="0.55" />
                  <GradientStop Color="#FF7B2FF7" Offset="1" />
                </RadialGradientBrush.GradientStops>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <Polygon Width="52" Height="44" Points="0,44 26,0 52,44" Fill="{StaticResource AuroraGradient}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Column="1"
            Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
      <StackPanel Spacing="8" VerticalAlignment="Center">
        <Border Height="34" CornerRadius="8" BorderBrush="{StaticResource AuroraGradient}" BorderThickness="3" />
        <TextBlock Text="A gradient border brush" Foreground="{StaticResource Muted}" FontSize="9" />
        <Border Height="34" CornerRadius="8" Background="{StaticResource AccentGradient}" OpacityMask="{StaticResource FadeMask}" />
        <TextBlock Text="The same gradient as a fading opacity mask" Foreground="{StaticResource Muted}" FontSize="9" />
      </StackPanel>
    </Border>
  </Grid>

  <Grid Width="540" Height="84">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
      <Border Height="44" CornerRadius="8" Background="{StaticResource AuroraGradient}" OpacityMask="{StaticResource FadeMask}" />
      <TextBlock Text="OpacityMask · Alpha" Foreground="{StaticResource Muted}" FontSize="9" />
    </StackPanel>
    <StackPanel Grid.Column="1" Spacing="4">
      <Border Height="44" CornerRadius="8" Background="{StaticResource AuroraGradient}"
              OpacityMask="{StaticResource LuminanceMask}" OpacityMaskMode="Luminance" />
      <TextBlock Text="OpacityMask · Luminance" Foreground="{StaticResource Muted}" FontSize="9" />
    </StackPanel>
  </Grid>

  <Border Width="540" Background="{StaticResource Raised}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="14">
    <StackPanel Spacing="3">
      <TextBlock Text="MARKUP" Foreground="{StaticResource Accent}" FontSize="8" />
      <TextBlock Text="&lt;Border.Background&gt;&#10;  &lt;LinearGradientBrush StartPoint=&quot;0,0&quot; EndPoint=&quot;1,1&quot;&gt;&#10;    &lt;GradientStop Color=&quot;#FF00D2FF&quot; Offset=&quot;0&quot; /&gt;&#10;    &lt;GradientStop Color=&quot;#FF7B2FF7&quot; Offset=&quot;1&quot; /&gt;&#10;  &lt;/LinearGradientBrush&gt;&#10;&lt;/Border.Background&gt;"
                 Foreground="{StaticResource Text}"
                 FontSize="10"
                 Wrap="True" />
    </StackPanel>
  </Border>

</local:ThemedStackPanel>
