<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.ExplicitStyleCard"
    Spacing="10">

  <StackPanel.Resources>
    <Style x:Key="ExplicitButton" TargetType="Button">
      <Style.Setters>
        <Setter Property="Background" Value="{StaticResource Selection}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
      </Style.Setters>
    </Style>
  </StackPanel.Resources>

  <Button Text="Explicit style" Height="32" Style="{StaticResource ExplicitButton}" />

</local:ThemedStackPanel>
