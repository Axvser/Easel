<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.Cards.AnimationTransform3DCard"
    Spacing="12">

  <local:ThemedStackPanel.Resources>
    <Rotate3DTransform x:Key="Flat" AngleX="0" AngleY="0" CenterX="95" CenterY="65" Depth="700" />
    <Rotate3DTransform x:Key="Tilted" AngleX="26" AngleY="34" CenterX="95" CenterY="65" Depth="700" />

    <Style x:Key="TiltableSurface" TargetType="Border">
      <Style.Setters>
        <Setter Property="Background" Value="{StaticResource DeepGradient}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="CacheAsBitmap" Value="True" />
      </Style.Setters>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Trigger.EnterAction>
            <TransitionAction Property="Transform3D" To="{StaticResource Tilted}" Duration="0:0:0.6" Ease="CubicOut" />
          </Trigger.EnterAction>
          <Trigger.ExitAction>
            <TransitionAction Property="Transform3D" To="{StaticResource Flat}" Duration="0:0:0.6" Ease="CubicOut" />
          </Trigger.ExitAction>
        </Trigger>
      </Style.Triggers>
    </Style>
  </local:ThemedStackPanel.Resources>

  <TextBlock Text="A Transform3D endpoint interpolates its own values: the angles sweep and the pivot and camera depth stay put, so the card tilts instead of collapsing."
             Foreground="{StaticResource Muted}"
             Wrap="True" />

  <Border Height="210"
          Background="{StaticResource SurfaceAlt}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="1"
          CornerRadius="10">
    <Grid>
      <Border x:Name="surface"
              Width="190"
              Height="130"
              Margin="24,0,0,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Style="{StaticResource TiltableSurface}">
        <Border.Transform3D>
          <Rotate3DTransform AngleX="0" AngleY="0" CenterX="95" CenterY="65" Depth="700" />
        </Border.Transform3D>
        <TextBlock Text="Tilt me" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="16,16,0,0" />
      </Border>
    </Grid>
  </Border>

  <StackPanel Orientation="Horizontal" Spacing="8">
    <Button Text="Start" Height="30" Click="OnStart" />
    <Button Text="Reset" Height="30" Click="OnReset" />
    <TextBlock Text="AngleX 0 → 26 · AngleY 0 → 34 · 600 ms CubicOut"
               VerticalAlignment="Center"
               Foreground="{StaticResource Muted}"
               FontSize="9" />
  </StackPanel>

  <Border Width="560"
          Background="{StaticResource Raised}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="1"
          CornerRadius="10"
          Padding="14">
    <StackPanel Spacing="3">
      <TextBlock Text="MARKUP" Foreground="{StaticResource Accent}" FontSize="8" />
      <TextBlock Text="&lt;Rotate3DTransform x:Key=&quot;Tilted&quot; AngleX=&quot;26&quot; AngleY=&quot;34&quot;&#10;                    CenterX=&quot;95&quot; CenterY=&quot;65&quot; Depth=&quot;700&quot; /&gt;&#10;&#10;&lt;TransitionAction Property=&quot;Transform3D&quot;&#10;                  To=&quot;{StaticResource Tilted}&quot;&#10;                  Duration=&quot;0:0:0.6&quot; Ease=&quot;CubicOut&quot; /&gt;"
                 Foreground="{StaticResource Text}"
                 FontSize="10"
                 Wrap="True" />
    </StackPanel>
  </Border>

</local:ThemedStackPanel>
