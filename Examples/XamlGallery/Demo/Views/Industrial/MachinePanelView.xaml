<local:ThemedDockPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.Industrial.MachinePanelView"
    Background="{StaticResource Surface}"
    Width="540"
    LastChildFill="True">

  <Border DockPanel.Dock="Top"
          Background="{StaticResource Surface}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="0,0,0,1"
          Padding="18,12">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Spacing="3">
        <TextBlock Text="VMC-850 · O1204"
                   Foreground="{StaticResource Text}"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding Status}"
                   Foreground="{StaticResource Muted}"
                   FontSize="9" />
      </StackPanel>

      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="10"
                  VerticalAlignment="Center">
        <Border Background="{StaticResource Raised}" CornerRadius="8" Padding="10,4">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="7" Height="7" Fill="{Binding CycleBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CycleText}" Foreground="{Binding CycleBrush}" FontSize="9" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <StackPanel Spacing="1" VerticalAlignment="Center">
          <TextBlock Text="CYCLE TIME" Foreground="{StaticResource Muted}" FontSize="8" />
          <TextBlock Text="{Binding CycleTimeText}" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="16">
    <StackPanel Spacing="12">

      <Border Background="{StaticResource Raised}"
              BorderBrush="{StaticResource Border}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14">
        <StackPanel Spacing="9">
          <Grid>
            <TextBlock Text="Axis position" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="ABSOLUTE · mm / deg"
                       Foreground="{StaticResource Muted}"
                       FontSize="8"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
          </Grid>

          <UniformGrid Rows="1" Columns="4" Height="78">
            <Border Background="{StaticResource Surface}" CornerRadius="7" Padding="9,8" Margin="0,0,6,0">
              <StackPanel Spacing="1">
                <TextBlock Text="X" Foreground="{StaticResource Signal}" FontSize="8" FontWeight="SemiBold" />
                <TextBlock Text="{Binding XText}" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="17" FontWeight="Bold" />
                <TextBlock Text="mm" Foreground="{StaticResource Muted}" FontSize="8" />
              </StackPanel>
            </Border>
            <Border Background="{StaticResource Surface}" CornerRadius="7" Padding="9,8" Margin="0,0,6,0">
              <StackPanel Spacing="1">
                <TextBlock Text="Y" Foreground="{StaticResource Signal}" FontSize="8" FontWeight="SemiBold" />
                <TextBlock Text="{Binding YText}" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="17" FontWeight="Bold" />
                <TextBlock Text="mm" Foreground="{StaticResource Muted}" FontSize="8" />
              </StackPanel>
            </Border>
            <Border Background="{StaticResource Surface}" CornerRadius="7" Padding="9,8" Margin="0,0,6,0">
              <StackPanel Spacing="1">
                <TextBlock Text="Z" Foreground="{StaticResource Signal}" FontSize="8" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ZText}" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="17" FontWeight="Bold" />
                <TextBlock Text="mm" Foreground="{StaticResource Muted}" FontSize="8" />
              </StackPanel>
            </Border>
            <Border Background="{StaticResource Surface}" CornerRadius="7" Padding="9,8">
              <StackPanel Spacing="1">
                <TextBlock Text="A" Foreground="{StaticResource Signal}" FontSize="8" FontWeight="SemiBold" />
                <TextBlock Text="{Binding AText}" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="17" FontWeight="Bold" />
                <TextBlock Text="deg" Foreground="{StaticResource Muted}" FontSize="8" />
              </StackPanel>
            </Border>
          </UniformGrid>
        </StackPanel>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource Raised}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,12,0">
          <StackPanel Spacing="9">
            <Grid>
              <TextBlock Text="Jog" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="0.100 mm · rapid off" Foreground="{StaticResource Muted}" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <UniformGrid Rows="2" Columns="4" Height="76">
              <Button Text="-X" Height="34" Margin="0,0,5,5" Command="{Binding JogCommand}" CommandParameter="X:-1" />
              <Button Text="+X" Height="34" Margin="0,0,5,5" Command="{Binding JogCommand}" CommandParameter="X:1" />
              <Button Text="-Y" Height="34" Margin="0,0,5,5" Command="{Binding JogCommand}" CommandParameter="Y:-1" />
              <Button Text="+Y" Height="34" Margin="0,0,0,5" Command="{Binding JogCommand}" CommandParameter="Y:1" />
              <Button Text="-Z" Height="34" Margin="0,0,5,0" Command="{Binding JogCommand}" CommandParameter="Z:-1" />
              <Button Text="+Z" Height="34" Margin="0,0,5,0" Command="{Binding JogCommand}" CommandParameter="Z:1" />
              <Button Text="-A" Height="34" Margin="0,0,5,0" Command="{Binding JogCommand}" CommandParameter="A:-1" />
              <Button Text="+A" Height="34" Command="{Binding JogCommand}" CommandParameter="A:1" />
            </UniformGrid>
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Background="{StaticResource Raised}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14">
          <StackPanel Spacing="8">
            <TextBlock Text="Machine control" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" />
            <Button Text="Cycle start / hold" Height="30" Command="{Binding ToggleCycleCommand}" />
            <Button Text="{Binding CoolantText}" Height="30" Command="{Binding ToggleCoolantCommand}" />
            <Button Text="{Binding EmergencyText}"
                    Height="34"
                    Background="{Binding EmergencyBrush}"
                    Foreground="{StaticResource AccentText}"
                    Command="{Binding ToggleEmergencyCommand}" />
            <Grid Margin="0,2,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                <Ellipse Width="7" Height="7" Fill="{Binding CycleBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CycleText}" Foreground="{StaticResource Muted}" FontSize="8" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Ellipse Width="7" Height="7" Fill="{Binding CoolantBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CoolantText}" Foreground="{StaticResource Muted}" FontSize="8" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource Raised}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,12,0">
          <StackPanel Spacing="7">
            <Grid>
              <TextBlock Text="Spindle" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="T02" Foreground="{StaticResource Signal}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Grid Width="120" Height="120" HorizontalAlignment="Center">
              <Path Data="{Binding SpindleTicks}" Stroke="{StaticResource HmiTrack}" StrokeThickness="1" />
              <Path Data="{Binding SpindleArc}" Stroke="{Binding SpindleBrush}" StrokeThickness="6" />
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0">
                <TextBlock Text="{Binding SpindleText}" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="LOAD" Foreground="{StaticResource Muted}" FontSize="7" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>

            <Grid>
              <TextBlock Text="SPEED" Foreground="{StaticResource Muted}" FontSize="8" />
              <TextBlock Text="{Binding SpindleRpmText}" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Right" />
            </Grid>
            <StackPanel Spacing="2">
              <Grid>
                <TextBlock Text="FEED OVERRIDE" Foreground="{StaticResource Muted}" FontSize="8" />
                <TextBlock Text="{Binding FeedOverrideText}" Foreground="{StaticResource Signal}" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Right" />
              </Grid>
              <Slider Height="22" Minimum="10" Maximum="120" Value="{Binding FeedOverride, Mode=TwoWay}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Background="{StaticResource Raised}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14">
          <StackPanel Spacing="8">
            <Grid>
              <TextBlock Text="Tool table" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="pocket · Ø · speed"
                         Foreground="{StaticResource Muted}"
                         FontSize="8"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Tools}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="38" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="54" />
                      <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Slot}" Foreground="{StaticResource Signal}" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="{StaticResource Text}" FontSize="9" />
                    <TextBlock Grid.Column="2" Text="{Binding DiameterText}" Foreground="{StaticResource Muted}" FontSize="9" />
                    <TextBlock Grid.Column="3" Text="{Binding SpeedText}" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="{StaticResource Surface}" CornerRadius="7" Padding="9,7" Margin="0,2,0,0">
              <StackPanel Spacing="3">
                <Grid>
                  <TextBlock Text="RAPID OVERRIDE" Foreground="{StaticResource Muted}" FontSize="7" />
                  <TextBlock Text="50%" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar Height="5" Maximum="100" Value="50" FillBrush="{StaticResource Signal}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <Grid>
        <StackPanel Orientation="Horizontal" Spacing="14">
          <TextBlock Text="O1204 · FACE MILL" Foreground="{StaticResource Muted}" FontSize="8" />
          <TextBlock Text="N1420 G01 X128.440 Y-42.180" Foreground="{StaticResource Signal}" FontFamily="Consolas" FontSize="8" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="8" HorizontalAlignment="Right" />
      </Grid>

    </StackPanel>
  </ScrollViewer>

</local:ThemedDockPanel>
