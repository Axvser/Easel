<local:ThemedDockPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.Industrial.TearOffView"
    Background="{StaticResource Surface}"
    Width="540"
    LastChildFill="True">

  <Border DockPanel.Dock="Top"
          Background="{StaticResource Surface}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="0,0,0,1"
          Padding="18,12">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Spacing="3">
        <TextBlock Text="TEAR-OFF PANEL"
                   Foreground="{StaticResource Text}"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding Status}"
                   Foreground="{StaticResource Muted}"
                   FontSize="9" />
      </StackPanel>

      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="10"
                  VerticalAlignment="Center">
        <Border Background="{StaticResource Raised}" CornerRadius="8" Padding="10,4">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="7" Height="7" Fill="{StaticResource Signal}" VerticalAlignment="Center" />
            <TextBlock Text="2 HOSTS" Foreground="{StaticResource Signal}" FontSize="9" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <StackPanel Spacing="1" VerticalAlignment="Center">
          <TextBlock Text="LAST SAMPLE" Foreground="{StaticResource Muted}" FontSize="8" />
          <TextBlock Text="{Binding Updated}" Foreground="{StaticResource Text}" FontSize="11" FontWeight="SemiBold" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="16">
    <StackPanel Spacing="12">

      <Grid Height="400">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="224" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource Raised}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,12,0">
          <StackPanel Spacing="10">
            <Grid>
              <TextBlock Text="Plant overview" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" />
              <Border Background="{StaticResource Surface}" CornerRadius="7" Padding="8,3" HorizontalAlignment="Right">
                <TextBlock Text="LIVE" Foreground="{StaticResource Signal}" FontSize="8" />
              </Border>
            </Grid>

            <Grid Height="78">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="{StaticResource Surface}" CornerRadius="7" Padding="7,7" Margin="0,0,6,0">
                <StackPanel Spacing="1">
                  <TextBlock Text="LINE A" Foreground="{StaticResource Positive}" FontSize="7" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding OeeText}" Foreground="{StaticResource Text}" FontSize="13" FontWeight="Bold" />
                  <TextBlock Text="OEE" Foreground="{StaticResource Muted}" FontSize="7" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Background="{StaticResource Surface}" CornerRadius="7" Padding="7,7" Margin="0,0,6,0">
                <StackPanel Spacing="1">
                  <TextBlock Text="LINE B" Foreground="{StaticResource Warning}" FontSize="7" FontWeight="SemiBold" />
                  <TextBlock Text="76.4%" Foreground="{StaticResource Text}" FontSize="13" FontWeight="Bold" />
                  <TextBlock Text="OEE" Foreground="{StaticResource Muted}" FontSize="7" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Background="{StaticResource Surface}" CornerRadius="7" Padding="7,7">
                <StackPanel Spacing="1">
                  <TextBlock Text="UTILITIES" Foreground="{StaticResource Signal}" FontSize="7" FontWeight="SemiBold" />
                  <TextBlock Text="92.1%" Foreground="{StaticResource Text}" FontSize="13" FontWeight="Bold" />
                  <TextBlock Text="LOAD" Foreground="{StaticResource Muted}" FontSize="7" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="10,8">
              <StackPanel Spacing="5">
                <Grid>
                  <TextBlock Text="THROUGHPUT · LAST 30 MIN" Foreground="{StaticResource Muted}" FontSize="7" />
                  <TextBlock Text="{Binding ThroughputText}" Foreground="{StaticResource Text}" FontSize="9" HorizontalAlignment="Right" />
                </Grid>
                <Viewbox Width="220" Height="92" Stretch="Uniform" HorizontalAlignment="Left">
                  <Canvas Width="470" Height="118">
                    <Line X1="0" Y1="20" X2="470" Y2="20" Stroke="{StaticResource HmiGrid}" StrokeThickness="1" />
                    <Line X1="0" Y1="52" X2="470" Y2="52" Stroke="{StaticResource HmiGrid}" StrokeThickness="1" />
                    <Line X1="0" Y1="84" X2="470" Y2="84" Stroke="{StaticResource HmiGrid}" StrokeThickness="1" />
                    <Line X1="0" Y1="116" X2="470" Y2="116" Stroke="{StaticResource HmiGrid}" StrokeThickness="1" />
                    <Polygon Points="{Binding ThroughputAreaPoints}" Fill="{StaticResource SignalGradient}" Opacity="0.28" />
                    <Polyline Points="{Binding ThroughputPoints}" Stroke="{StaticResource Signal}" StrokeThickness="2.5" />
                  </Canvas>
                </Viewbox>
              </StackPanel>
            </Border>

            <TextBlock Text="The LINE STATUS panel can stay in this column or live in its own window. The visual subtree is the same object in both hosts."
                       Foreground="{StaticResource Muted}"
                       FontSize="8"
                       Wrap="True" />
          </StackPanel>
        </Border>

        <Grid Grid.Column="1">
          <Border x:Name="DockSlot"
                  Background="{StaticResource Surface}"
                  BorderBrush="{StaticResource Border}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="0">
            <Border x:Name="DetachablePanel"
                    Background="{StaticResource Raised}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0"
                    CornerRadius="10">
              <DockPanel LastChildFill="True">
                <Border x:Name="DragBar"
                        DockPanel.Dock="Top"
                        Height="38"
                        Background="{StaticResource Surface}"
                        Padding="10,6"
                        PointerPressed="OnDragBarPressed"
                        PointerMoved="OnDragBarMoved"
                        PointerReleased="OnDragBarReleased">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                      <Ellipse Width="3" Height="12" Fill="{StaticResource Muted}" Opacity="0.6" />
                      <Ellipse Width="3" Height="12" Fill="{StaticResource Muted}" Opacity="0.6" />
                      <TextBlock Text="LINE STATUS" Foreground="{StaticResource Text}" FontSize="8" FontWeight="SemiBold" Margin="3,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="DetachButton"
                            Grid.Column="1"
                            Text="DETACH"
                            Height="22"
                            Width="72"
                            FontSize="7"
                            Click="OnDetachClicked" />
                  </Grid>
                </Border>

                <StackPanel Spacing="8" Margin="10">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Positive}" VerticalAlignment="Center" />
                    <TextBlock Text="RUNNING" Foreground="{StaticResource Positive}" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>

                  <Grid>
                    <TextBlock Text="OEE" Foreground="{StaticResource Muted}" FontSize="8" />
                    <TextBlock Text="{Binding OeeText}" Foreground="{StaticResource Text}" FontSize="11" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid>
                    <TextBlock Text="THROUGHPUT" Foreground="{StaticResource Muted}" FontSize="8" />
                    <TextBlock Text="{Binding ThroughputText}" Foreground="{StaticResource Text}" FontSize="11" HorizontalAlignment="Right" />
                  </Grid>
                  <Grid>
                    <TextBlock Text="SCRAP" Foreground="{StaticResource Muted}" FontSize="8" />
                    <TextBlock Text="{Binding ScrapText}" Foreground="{StaticResource Text}" FontSize="11" HorizontalAlignment="Right" />
                  </Grid>

                  <Viewbox Width="200" Height="58" Stretch="Uniform" HorizontalAlignment="Left">
                    <Canvas Width="470" Height="118">
                      <Line X1="0" Y1="20" X2="470" Y2="20" Stroke="{StaticResource HmiGrid}" StrokeThickness="1" />
                      <Line X1="0" Y1="52" X2="470" Y2="52" Stroke="{StaticResource HmiGrid}" StrokeThickness="1" />
                      <Line X1="0" Y1="84" X2="470" Y2="84" Stroke="{StaticResource HmiGrid}" StrokeThickness="1" />
                      <Line X1="0" Y1="116" X2="470" Y2="116" Stroke="{StaticResource HmiGrid}" StrokeThickness="1" />
                      <Polygon Points="{Binding ThroughputAreaPoints}" Fill="{StaticResource SignalGradient}" Opacity="0.28" />
                      <Polyline Points="{Binding ThroughputPoints}" Stroke="{StaticResource Signal}" StrokeThickness="2.5" />
                    </Canvas>
                  </Viewbox>

                  <TextBlock Text="Drag the header out. Drag the window back over this column to dock."
                             Foreground="{StaticResource Muted}"
                             FontSize="7"
                             Wrap="True" />
                </StackPanel>
              </DockPanel>
            </Border>
          </Border>

          <Border x:Name="DockPlaceholder"
                  Visibility="Collapsed"
                  Background="{StaticResource Surface}"
                  BorderBrush="{StaticResource Border}"
                  BorderThickness="1"
                  CornerRadius="10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="5" Margin="16">
              <TextBlock Text="PANEL DETACHED" Foreground="{StaticResource Signal}" FontSize="9" FontWeight="SemiBold" TextAlignment="Center" />
              <TextBlock Text="Drag the window back here to dock"
                         Foreground="{StaticResource Muted}"
                         FontSize="8"
                         Wrap="True"
                         TextAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <Grid>
        <StackPanel Orientation="Horizontal" Spacing="14">
          <TextBlock Text="ONE VISUAL TREE · TWO HOSTS" Foreground="{StaticResource Muted}" FontSize="8" />
          <TextBlock Text="VisualForm.Content moves the same subtree" Foreground="{StaticResource Signal}" FontSize="8" />
        </StackPanel>
        <TextBlock Text="drag out · drag back · or use DETACH" Foreground="{StaticResource Muted}" FontSize="8" HorizontalAlignment="Right" />
      </Grid>

    </StackPanel>
  </ScrollViewer>

</local:ThemedDockPanel>
