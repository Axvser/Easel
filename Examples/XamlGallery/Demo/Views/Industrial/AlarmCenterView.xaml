<local:ThemedDockPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.Industrial.AlarmCenterView"
    Background="{StaticResource Surface}"
    Width="540"
    LastChildFill="True">

  <Border DockPanel.Dock="Top"
          Background="{StaticResource Surface}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="0,0,0,1"
          Padding="18,12">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Spacing="3">
        <TextBlock Text="ALARM &amp; EVENT CENTER"
                   Foreground="{StaticResource Text}"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding Status}"
                   Foreground="{StaticResource Muted}"
                   FontSize="9" />
      </StackPanel>

      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="10"
                  VerticalAlignment="Center">
        <Border Background="{StaticResource Raised}" CornerRadius="8" Padding="10,4">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="7" Height="7" Fill="{StaticResource Danger}" VerticalAlignment="Center" />
            <TextBlock Text="ACTIVE" Foreground="{StaticResource Danger}" FontSize="9" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
        <StackPanel Spacing="1" VerticalAlignment="Center">
          <TextBlock Text="UNACKNOWLEDGED" Foreground="{StaticResource Muted}" FontSize="8" />
          <TextBlock Text="{Binding UnackedCount}" Foreground="{StaticResource Text}" FontSize="11" FontWeight="SemiBold" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="16">
    <StackPanel Spacing="12">

      <Grid Height="88">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource Raised}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,10,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Danger}" CornerRadius="2" />
            <StackPanel Grid.Column="1" Spacing="1" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="CRITICAL" Foreground="{StaticResource Danger}" FontSize="8" FontWeight="SemiBold" />
              <TextBlock Text="{Binding CriticalCount}" Foreground="{StaticResource Text}" FontSize="24" FontWeight="Bold" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="{StaticResource Raised}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,10,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Warning}" CornerRadius="2" />
            <StackPanel Grid.Column="1" Spacing="1" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="WARNING" Foreground="{StaticResource Warning}" FontSize="8" FontWeight="SemiBold" />
              <TextBlock Text="{Binding WarningCount}" Foreground="{StaticResource Text}" FontSize="24" FontWeight="Bold" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="{StaticResource Raised}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Signal}" CornerRadius="2" />
            <StackPanel Grid.Column="1" Spacing="1" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="INFO" Foreground="{StaticResource Signal}" FontSize="8" FontWeight="SemiBold" />
              <TextBlock Text="{Binding InfoCount}" Foreground="{StaticResource Text}" FontSize="24" FontWeight="Bold" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Grid>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Text="All" Height="28" Click="OnShowAll" />
          <Button Text="Unacked" Height="28" Click="OnShowUnacked" />
          <Button Text="Critical" Height="28" Click="OnShowCritical" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
          <TextBlock Text="{Binding Filter}" Foreground="{StaticResource Signal}" FontSize="9" VerticalAlignment="Center" />
          <Button Text="Acknowledge visible" Height="28" Click="OnAcknowledgeVisible" />
        </StackPanel>
      </Grid>

      <Border Background="{StaticResource Raised}"
              BorderBrush="{StaticResource Border}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14">
        <StackPanel Spacing="8">
          <Grid>
            <TextBlock Text="Alarm list" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="tag · message · state"
                       Foreground="{StaticResource Muted}"
                       FontSize="8"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Visible}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource Surface}"
                        CornerRadius="7"
                        Padding="10,8"
                        Margin="0,0,0,6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="3" />
                      <ColumnDefinition Width="56" />
                      <ColumnDefinition Width="60" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="58" />
                      <ColumnDefinition Width="66" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{Binding SeverityBrush}" CornerRadius="2" />
                    <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{StaticResource Muted}" FontSize="8" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Tag}" Foreground="{StaticResource Text}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="{StaticResource Text}" FontSize="9" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="5"
                            Text="ACK"
                            Height="26"
                            Width="60"
                            FontSize="9"
                            Command="{Binding AckCommand}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource Raised}"
              BorderBrush="{StaticResource Border}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14">
        <StackPanel Spacing="7">
          <TextBlock Text="Event log" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="58" />
              <ColumnDefinition Width="72" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="09:45:02" Foreground="{StaticResource Muted}" FontSize="8" />
            <TextBlock Grid.Column="1" Text="OPERATOR" Foreground="{StaticResource Signal}" FontSize="8" />
            <TextBlock Grid.Column="2" Text="Shift B acknowledged PUMP-2 coolant alarm" Foreground="{StaticResource Muted}" FontSize="8" />
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="58" />
              <ColumnDefinition Width="72" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="09:44:51" Foreground="{StaticResource Muted}" FontSize="8" />
            <TextBlock Grid.Column="1" Text="SYS" Foreground="{StaticResource Signal}" FontSize="8" />
            <TextBlock Grid.Column="2" Text="Recipe 24-118 entered mixing stage" Foreground="{StaticResource Muted}" FontSize="8" />
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="58" />
              <ColumnDefinition Width="72" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="09:38:02" Foreground="{StaticResource Muted}" FontSize="8" />
            <TextBlock Grid.Column="1" Text="PUMP-2" Foreground="{StaticResource Danger}" FontSize="8" />
            <TextBlock Grid.Column="2" Text="Coolant pressure low · 1.2 bar" Foreground="{StaticResource Muted}" FontSize="8" />
          </Grid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</local:ThemedDockPanel>
