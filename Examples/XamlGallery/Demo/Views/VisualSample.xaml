<local:ThemedStackPanel
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Demo.Views"
    x:Class="Demo.Views.VisualSample"
    Orientation="Horizontal"
    Spacing="12">

  <Border Width="300"
            Height="110"
            Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14">
    <StackPanel Spacing="6">
      <TextBlock x:Name="sampleTitle"
                   Text="Visual XAML"
                   Foreground="{StaticResource Text}" />
      <TextBlock x:Name="sampleStatus"
                   Text="Generated from visual XAML"
                   Foreground="{StaticResource Muted}"
                   Wrap="True" />
    </StackPanel>
  </Border>

  <Button x:Name="sampleAction"
            Text="Compile again"
            Height="32"
            Click="OnSampleClick" />

</local:ThemedStackPanel>
