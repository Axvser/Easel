<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Demo.Themes.MidnightTheme">

  <!-- A custom theme, authored the same way as a WPF ResourceDictionary. The gallery owns it; Easel's
       built-in palettes (Dark+/Light+/HighContrast) live in the library's Themes folder. -->
  <SolidColorBrush x:Key="Window" Color="#FF0B1020" />
  <SolidColorBrush x:Key="Surface" Color="#FF121A2E" />
  <SolidColorBrush x:Key="Raised" Color="#FF1A2440" />
  <SolidColorBrush x:Key="Input" Color="#FF0F1526" />
  <SolidColorBrush x:Key="Border" Color="#FF2A3A5C" />
  <SolidColorBrush x:Key="BorderHover" Color="#FF3B5280" />
  <SolidColorBrush x:Key="Hover" Color="#FF1E2B47" />
  <SolidColorBrush x:Key="Pressed" Color="#FF27385A" />
  <SolidColorBrush x:Key="Text" Color="#FFE6ECFF" />
  <SolidColorBrush x:Key="Muted" Color="#FF9AA8C7" />
  <SolidColorBrush x:Key="Accent" Color="#FF7B6CFF" />
  <SolidColorBrush x:Key="AccentText" Color="#FF0B1020" />
  <SolidColorBrush x:Key="Focus" Color="#FF4CC9F0" />
  <SolidColorBrush x:Key="Caret" Color="#FF4CC9F0" />
  <SolidColorBrush x:Key="Selection" Color="#FF2B2A6B" />
  <SolidColorBrush x:Key="SelectedText" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Disabled" Color="#FF0A0F1B" />
  <SolidColorBrush x:Key="DisabledText" Color="#FF5A6785" />

  <SolidColorBrush x:Key="SurfaceAlt" Color="#FF1A2440" />

  <SolidColorBrush x:Key="ScrollBarThumb" Color="#66A9B7D9" />
  <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#CCE6ECFF" />
  <SolidColorBrush x:Key="ShapeStroke" Color="#888C7CFF" />
  <SolidColorBrush x:Key="ShadowColor" Color="#FF000000" />

  <x:String x:Key="FontFamily">Segoe UI</x:String>
  <x:Double x:Key="FontSize">9.5</x:Double>
  <x:FontWeight x:Key="FontWeight">Normal</x:FontWeight>

  <x:Double x:Key="CornerRadius">8</x:Double>
  <x:Double x:Key="InputCornerRadius">10</x:Double>
  <x:Int32 x:Key="ControlHeight">30</x:Int32>

  <x:Thickness x:Key="ControlBorderThickness">1</x:Thickness>
  <x:Double x:Key="FocusThickness">1.6</x:Double>
  <x:Double x:Key="FocusThicknessMedium">1.4</x:Double>
  <x:Double x:Key="FocusThicknessThin">1</x:Double>
  <x:Double x:Key="ScrollBarThumbRadius">3</x:Double>
  <x:Double x:Key="ShapeStrokeThickness">1.5</x:Double>
  <x:PointF x:Key="ShadowOffset">4,6</x:PointF>
  <x:Double x:Key="ShadowBlur">6</x:Double>
  <x:Double x:Key="ShadowOpacity">0.45</x:Double>

  <SolidColorBrush x:Key="TextVisualForeground" Color="#FFE6ECFF" />
  <x:String x:Key="TextVisualFontFamily">Segoe UI</x:String>
  <x:Double x:Key="TextVisualFontSize">9</x:Double>
  <x:FontWeight x:Key="TextVisualFontWeight">Normal</x:FontWeight>

  <Style x:Key="Body" TargetType="TextBlock">
    <Style.Setters>
      <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style.Setters>
  </Style>
  <Style x:Key="Subheading" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Style.Setters>
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style.Setters>
  </Style>
  <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Subheading}">
    <Style.Setters>
      <Setter Property="FontSize" Value="19" />
    </Style.Setters>
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Style.Setters>
      <Setter Property="FontSize" Value="9" />
      <Setter Property="Opacity" Value="0.65" />
    </Style.Setters>
  </Style>

</ResourceDictionary>
