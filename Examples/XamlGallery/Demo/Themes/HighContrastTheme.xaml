<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Demo.Themes.HighContrastTheme">

  <!-- A custom theme, authored the same way as a WPF ResourceDictionary. It is not one of Easel's built-in
       fallbacks: the demo owns it and feeds both the visual resource sets and a ThemePalette. -->
  <SolidColorBrush x:Key="Window" Color="#FF000000" />
  <SolidColorBrush x:Key="Surface" Color="#FF0A0A0A" />
  <SolidColorBrush x:Key="Raised" Color="#FF161616" />
  <SolidColorBrush x:Key="Input" Color="#FF101010" />
  <SolidColorBrush x:Key="Border" Color="#FF6F6F6F" />
  <SolidColorBrush x:Key="BorderHover" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Hover" Color="#FF1F1F1F" />
  <SolidColorBrush x:Key="Pressed" Color="#FF2E2E2E" />
  <SolidColorBrush x:Key="Text" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Muted" Color="#FFCFCFCF" />
  <SolidColorBrush x:Key="Accent" Color="#FFFFB000" />
  <SolidColorBrush x:Key="AccentText" Color="#FF000000" />
  <SolidColorBrush x:Key="Focus" Color="#FFFFD700" />
    <SolidColorBrush x:Key="Caret" Color="#FFFFD54A" />
  <SolidColorBrush x:Key="Selection" Color="#FF6B4600" />
  <SolidColorBrush x:Key="SelectedText" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Disabled" Color="#FF050505" />
  <SolidColorBrush x:Key="DisabledText" Color="#FF8A8A8A" />

  <SolidColorBrush x:Key="SurfaceAlt" Color="#FF161616" />

  <SolidColorBrush x:Key="ScrollBarThumb" Color="#66CFCFCF" />
  <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#CCFFFFFF" />
  <SolidColorBrush x:Key="ShapeStroke" Color="#885B8CFF" />
  <SolidColorBrush x:Key="ShadowColor" Color="#FF000000" />

  <x:String x:Key="FontFamily">Segoe UI</x:String>
  <x:Double x:Key="FontSize">9.5</x:Double>
  <x:FontWeight x:Key="FontWeight">Normal</x:FontWeight>

  <x:Double x:Key="CornerRadius">2</x:Double>
  <x:Double x:Key="InputCornerRadius">2</x:Double>
  <x:Int32 x:Key="ControlHeight">30</x:Int32>

  <x:Thickness x:Key="ControlBorderThickness">1</x:Thickness>
  <x:Double x:Key="FocusThickness">1.6</x:Double>
  <x:Double x:Key="FocusThicknessMedium">1.4</x:Double>
  <x:Double x:Key="FocusThicknessThin">1</x:Double>
  <x:Double x:Key="ScrollBarThumbRadius">3</x:Double>
  <x:Double x:Key="ShapeStrokeThickness">1.5</x:Double>
  <x:PointF x:Key="ShadowOffset">4,6</x:PointF>
  <x:Double x:Key="ShadowBlur">6</x:Double>
  <x:Double x:Key="ShadowOpacity">0.45</x:Double>

  <SolidColorBrush x:Key="TextVisualForeground" Color="#FFFFFFFF" />
  <x:String x:Key="TextVisualFontFamily">Segoe UI</x:String>
  <x:Double x:Key="TextVisualFontSize">9</x:Double>
  <x:FontWeight x:Key="TextVisualFontWeight">Normal</x:FontWeight>

  <Style x:Key="Body" TargetType="TextBlock">
    <Style.Setters>
      <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style.Setters>
  </Style>
  <Style x:Key="Subheading" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Style.Setters>
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style.Setters>
  </Style>
  <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Subheading}">
    <Style.Setters>
      <Setter Property="FontSize" Value="19" />
    </Style.Setters>
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Style.Setters>
      <Setter Property="FontSize" Value="9" />
      <Setter Property="Opacity" Value="0.65" />
    </Style.Setters>
  </Style>

</ResourceDictionary>
