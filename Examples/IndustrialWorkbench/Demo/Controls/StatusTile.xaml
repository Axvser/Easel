<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:IndustrialWorkbench.Controls"
    x:Class="IndustrialWorkbench.Controls.StatusTile">

  <!-- A composite control authored as XAML; the code-behind adds the dependency properties and binds the
       inner host's DataContext to the tile, so the caller's inherited context is untouched. -->
  <Border x:Name="SelfHost"
          Background="{StaticResource HmiPanel}"
          BorderBrush="{StaticResource HmiLine}"
          BorderThickness="1"
          CornerRadius="4"
          Padding="12,10">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <local:LedLamp Grid.Column="0"
                     Width="30"
                     Height="30"
                     Margin="0,0,10,0"
                     IsOn="{Binding IsOn}"
                     LampColor="{Binding LampBrush}" />

      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}"
                   Foreground="{StaticResource HmiMuted}"
                   FontSize="8" />
        <TextBlock Text="{Binding Value}"
                   Foreground="{StaticResource HmiText}"
                   FontFamily="Consolas"
                   FontSize="20"
                   FontWeight="Bold" />
        <TextBlock Text="{Binding Caption}"
                   Foreground="{StaticResource HmiMuted}"
                   FontSize="8" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
