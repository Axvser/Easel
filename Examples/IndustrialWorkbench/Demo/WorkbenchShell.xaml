<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ind="clr-namespace:IndustrialWorkbench.Controls"
    x:Class="IndustrialWorkbench.WorkbenchShell"
    Background="{StaticResource HmiBackground}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Factory status bar: site, line, runtime, SCADA link, E-STOP / RESET. -->
    <Border Grid.Row="0"
            Height="64"
            Background="{StaticResource HmiPanel}"
            BorderBrush="{StaticResource HmiLine}"
            BorderThickness="0,0,0,1"
            Padding="16,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="4" Background="{StaticResource HmiAccentDim}">
            <TextBlock Text="VD"
                       Foreground="{StaticResource HmiAccent}"
                       FontFamily="Consolas"
                       FontSize="14"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding StationName}"
                       Foreground="{StaticResource HmiText}"
                       FontSize="13"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding LineName}"
                       Foreground="{StaticResource HmiMuted}"
                       FontSize="8" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <StackPanel Spacing="1">
            <TextBlock Text="运行时间" Foreground="{StaticResource HmiMuted}" FontSize="8" />
            <TextBlock Text="{Binding RuntimeText}"
                       Foreground="{StaticResource HmiText}"
                       FontFamily="Consolas"
                       FontSize="15" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <ind:LedLamp Width="20" Height="20" IsOn="{Binding IsConnected}" LampColor="{StaticResource HmiNormal}" />
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="SCADA" Foreground="{StaticResource HmiMuted}" FontSize="8" />
              <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource HmiNormal}" FontSize="9" />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="1">
            <TextBlock Text="报警" Foreground="{StaticResource HmiMuted}" FontSize="8" />
            <TextBlock Text="{Binding AlarmCount, StringFormat='待确认 {0}'}"
                       Foreground="{StaticResource HmiAmber}"
                       FontFamily="Consolas"
                       FontSize="11" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Text="E-STOP"
                  Width="100"
                  Height="40"
                  Background="{StaticResource HmiDanger}"
                  Foreground="{StaticResource AccentText}"
                  FontSize="12"
                  FontWeight="Bold"
                  Click="OnEmergencyClick" />
          <Button Text="RESET"
                  Width="76"
                  Height="40"
                  Background="{StaticResource HmiPanelRaised}"
                  BorderBrush="{StaticResource HmiLineStrong}"
                  Foreground="{StaticResource HmiText}"
                  FontSize="11"
                  Click="OnResetClick" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Catalog + page. -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{StaticResource HmiPanelAlt}"
              BorderBrush="{StaticResource HmiLine}"
              BorderThickness="0,0,1,0"
              Padding="14,14,10,10">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,10">
            <TextBlock Text="控件目录" Foreground="{StaticResource HmiAccent}" FontSize="10" FontWeight="SemiBold" />
            <TextBlock Text="Overview 固定置顶 · 选中查看大图与用法" Foreground="{StaticResource HmiMuted}" FontSize="8" Wrap="True" />
          </StackPanel>
          <Border DockPanel.Dock="Bottom"
                  Background="{StaticResource HmiWell}"
                  BorderBrush="{StaticResource HmiLine}"
                  BorderThickness="1"
                  CornerRadius="3"
                  Padding="10,7"
                  Margin="0,10,0,0">
            <TextBlock Text="14 个工业控件 · 自绘 GDI+ + XAML"
                       Foreground="{StaticResource HmiMuted}"
                       FontSize="8"
                       Wrap="True" />
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <TreeView x:Name="CatalogTree" SelectionChanged="OnCatalogSelectionChanged" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <ContentControl x:Name="PageHost"
                      Grid.Column="1"
                      Background="{StaticResource HmiBackground}" />
    </Grid>

    <!-- Bottom hint strip. -->
    <Border Grid.Row="2"
            Height="26"
            Background="{StaticResource HmiPanel}"
            BorderBrush="{StaticResource HmiLine}"
            BorderThickness="0,1,0,0"
            Padding="16,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="模拟数据 · 旋钮拖动 / 阀门与拨杆点击 / 报警条点击确认"
                   Foreground="{StaticResource HmiMuted}"
                   FontSize="8"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding UpdateInterval, StringFormat='刷新 {0}'}"
                   Foreground="{StaticResource HmiMuted}"
                   FontSize="8"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
