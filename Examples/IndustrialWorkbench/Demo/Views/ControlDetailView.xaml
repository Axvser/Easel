<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="IndustrialWorkbench.Views.ControlDetailView"
    Background="{StaticResource HmiBackground}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header: title, group badge and one-sentence summary. -->
    <Border Grid.Row="0"
            Background="{StaticResource HmiPanel}"
            BorderBrush="{StaticResource HmiLine}"
            BorderThickness="0,0,0,1"
            Padding="20,14">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock x:Name="TitleText"
                     Text="CircularGauge"
                     Foreground="{StaticResource HmiText}"
                     FontSize="20"
                     FontWeight="SemiBold" />
          <Border Background="{StaticResource HmiAccentDim}"
                  CornerRadius="3"
                  Padding="8,2"
                  VerticalAlignment="Center">
            <TextBlock x:Name="GroupBadgeText"
                       Text="仪表"
                       Foreground="{StaticResource HmiAccent}"
                       FontSize="9" />
          </Border>
        </StackPanel>
        <TextBlock x:Name="SummaryText"
                   Text=""
                   Foreground="{StaticResource HmiMuted}"
                   FontSize="10"
                   Wrap="True"
                   MaxWidth="760" />
      </StackPanel>
    </Border>

    <!-- Live instance on the left, property readout on the right. -->
    <Grid Grid.Row="1" Margin="16,14,16,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="290" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="{StaticResource HmiWell}"
              BorderBrush="{StaticResource HmiLine}"
              BorderThickness="1"
              CornerRadius="4"
              Margin="0,0,14,0"
              ClipToBounds="True">
        <ContentControl x:Name="DetailHost" />
      </Border>

      <Border Grid.Column="1"
              Background="{StaticResource HmiPanel}"
              BorderBrush="{StaticResource HmiLine}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="14">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Top"
                     Text="关键属性 / 实时状态"
                     Foreground="{StaticResource HmiAccent}"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Margin="0,0,0,10" />
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ReadoutHost" Spacing="8" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Copyable XAML usage. -->
    <Border Grid.Row="2"
            Background="{StaticResource HmiPanel}"
            BorderBrush="{StaticResource HmiLine}"
            BorderThickness="0,1,0,0"
            Padding="16,12">
      <StackPanel Spacing="8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     Text="XAML 用法（本地前缀 xmlns:ind=&quot;clr-namespace:IndustrialWorkbench.Controls&quot;）"
                     Foreground="{StaticResource HmiMuted}"
                     FontSize="9"
                     Wrap="True"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="CopyHint"
                     Grid.Column="1"
                     Text=""
                     Foreground="{StaticResource HmiNormal}"
                     FontSize="9"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0" />
          <Button x:Name="CopyButton"
                  Grid.Column="2"
                  Text="复制"
                  Height="26"
                  Width="70"
                  Click="OnCopyClick" />
        </Grid>
        <Border Background="{StaticResource HmiWell}"
                BorderBrush="{StaticResource HmiLine}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="12,10">
          <TextBlock x:Name="UsageText"
                     Text=""
                     Foreground="{StaticResource HmiAccent}"
                     FontFamily="Consolas"
                     FontSize="10"
                     Wrap="True" />
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
