<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ind="clr-namespace:IndustrialWorkbench.Controls"
    x:Class="IndustrialWorkbench.Views.Controls.TankLevelView">

  <Border Background="{StaticResource HmiPanelAlt}"
          BorderBrush="{StaticResource HmiLine}"
          BorderThickness="1"
          CornerRadius="4"
          Padding="24">
    <StackPanel Orientation="Horizontal" Spacing="32" HorizontalAlignment="Center" VerticalAlignment="Center">
      <ind:TankLevel Width="220"
                     Height="380"
                     Title="T-301 清水罐"
                     Unit="%"
                     Value="{Binding TankLevel}"
                     LowLimit="15"
                     HighLimit="85"
                     Phase="{Binding FlowPhase}" />
      <StackPanel Spacing="10" VerticalAlignment="Center" Width="200">
        <TextBlock Text="液面随 Phase 波动，超过上下限转琥珀色"
                   Foreground="{StaticResource HmiMuted}"
                   FontSize="9"
                   Wrap="True" />
        <TextBlock Text="拖动旋钮可改变进出水平衡"
                   Foreground="{StaticResource HmiMuted}"
                   FontSize="9"
                   Wrap="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
