<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ind="clr-namespace:IndustrialWorkbench.Controls"
    x:Class="IndustrialWorkbench.Views.Controls.ToggleSwitchView">

  <Border Background="{StaticResource HmiPanelAlt}"
          BorderBrush="{StaticResource HmiLine}"
          BorderThickness="1"
          CornerRadius="4"
          Padding="24">
    <StackPanel Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="40" HorizontalAlignment="Center">
        <ind:ToggleSwitch Width="180"
                          Height="220"
                          Title="PUMP P-204"
                          IsOn="{Binding PumpOn, Mode=TwoWay}" />
        <ind:ToggleSwitch Width="180"
                          Height="220"
                          Title="AUX FAN"
                          IsOn="True"
                          OnBrush="{StaticResource HmiAmber}" />
      </StackPanel>
      <TextBlock Text="点击或按空格切换；Pump 状态写回 ViewModel 并驱动流量"
                 Foreground="{StaticResource HmiMuted}"
                 FontSize="9"
                 HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>
