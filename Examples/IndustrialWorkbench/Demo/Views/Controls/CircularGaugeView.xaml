<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ind="clr-namespace:IndustrialWorkbench.Controls"
    x:Class="IndustrialWorkbench.Views.Controls.CircularGaugeView">

  <Border Background="{StaticResource HmiPanelAlt}"
          BorderBrush="{StaticResource HmiLine}"
          BorderThickness="1"
          CornerRadius="4"
          Padding="24">
    <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
      <ind:CircularGauge Width="300"
                         Height="300"
                         Title=""
                         Unit="bar"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding Pressure}"
                         WarnThreshold="70"
                         DangerThreshold="90" />
      <TextBlock Text="Value / WarnThreshold / DangerThreshold 均可在 XAML 中直接设置"
                 Foreground="{StaticResource HmiMuted}"
                 FontSize="9"
                 HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>
