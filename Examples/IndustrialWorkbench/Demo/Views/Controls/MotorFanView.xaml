<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ind="clr-namespace:IndustrialWorkbench.Controls"
    x:Class="IndustrialWorkbench.Views.Controls.MotorFanView">

  <Border Background="{StaticResource HmiPanelAlt}"
          BorderBrush="{StaticResource HmiLine}"
          BorderThickness="1"
          CornerRadius="4"
          Padding="24">
    <StackPanel Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center">
      <ind:MotorFan Width="260"
                    Height="300"
                    Label="P-204 主泵"
                    Angle="{Binding FanAngle}"
                    Speed="{Binding FanSpeed}"
                    IsRunning="{Binding PumpOn}" />
      <TextBlock Text="Angle 由 ViewModel 每 150 ms 推进；Speed 仅作读数"
                 Foreground="{StaticResource HmiMuted}"
                 FontSize="9"
                 HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>
