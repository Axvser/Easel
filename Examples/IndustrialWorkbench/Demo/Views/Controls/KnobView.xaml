<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ind="clr-namespace:IndustrialWorkbench.Controls"
    x:Class="IndustrialWorkbench.Views.Controls.KnobView">

  <Border Background="{StaticResource HmiPanelAlt}"
          BorderBrush="{StaticResource HmiLine}"
          BorderThickness="1"
          CornerRadius="4"
          Padding="24">
    <StackPanel Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center">
      <ind:Knob Width="300"
                Height="330"
                Title="SETPOINT"
                Unit="%"
                Minimum="0"
                Maximum="100"
                Value="{Binding Setpoint, Mode=TwoWay}" />
      <TextBlock Text="拖动旋钮、滚轮或方向键改变设定值，压力与流量随之响应"
                 Foreground="{StaticResource HmiMuted}"
                 FontSize="9"
                 HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>
