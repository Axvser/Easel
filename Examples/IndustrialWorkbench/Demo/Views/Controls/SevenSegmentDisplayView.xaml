<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ind="clr-namespace:IndustrialWorkbench.Controls"
    x:Class="IndustrialWorkbench.Views.Controls.SevenSegmentDisplayView">

  <Border Background="{StaticResource HmiPanelAlt}"
          BorderBrush="{StaticResource HmiLine}"
          BorderThickness="1"
          CornerRadius="4"
          Padding="24">
    <StackPanel Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center">
      <ind:SevenSegmentDisplay Width="360"
                               Height="100"
                               Value="{Binding Throughput}"
                               Digits="5"
                               Decimals="1"
                               Unit="m³/h"
                               SegmentBrush="{StaticResource HmiAmber}" />
      <ind:SevenSegmentDisplay Width="260"
                               Height="72"
                               Value="{Binding Temperature}"
                               Digits="3"
                               Decimals="0"
                               Unit="°C"
                               SegmentBrush="{StaticResource HmiAccent}" />
      <TextBlock Text="小数位、负号、单位与发光段颜色均可配置"
                 Foreground="{StaticResource HmiMuted}"
                 FontSize="9"
                 HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>
