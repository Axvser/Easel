<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ind="clr-namespace:IndustrialWorkbench.Controls"
    x:Class="IndustrialWorkbench.Views.Controls.AlarmBannerView">

  <Border Background="{StaticResource HmiPanelAlt}"
          BorderBrush="{StaticResource HmiLine}"
          BorderThickness="1"
          CornerRadius="4"
          Padding="24">
    <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
      <ind:AlarmBanner Width="580"
                       Height="56"
                       Message="{Binding AlarmMessage}"
                       Severity="{Binding AlarmSeverity}"
                       IsActive="{Binding AlarmActive}"
                       IsAcknowledged="{Binding AlarmAcknowledged}"
                       Count="{Binding AlarmCount}"
                       Phase="{Binding Pulse}"
                       Acknowledged="OnAlarmAcknowledged" />
      <TextBlock Text="点击横幅即确认报警；危险级别（Severity=2）会脉冲闪烁"
                 Foreground="{StaticResource HmiMuted}"
                 FontSize="9"
                 HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
</UserControl>
