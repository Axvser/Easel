<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="IndustrialWorkbench.App">

  <!-- The workbench starts dark; the HMI palette below is the single source of the industrial
       semantic colours every control and view reads. -->
  <x:String x:Key="StartupTheme">Dark</x:String>

  <!-- Surfaces: graphite / charcoal, not the generic dark grey of a business dashboard. -->
  <SolidColorBrush x:Key="HmiBackground" Color="#FF070B10" />
  <SolidColorBrush x:Key="HmiPanel" Color="#FF0E151D" />
  <SolidColorBrush x:Key="HmiPanelAlt" Color="#FF0A1017" />
  <SolidColorBrush x:Key="HmiPanelRaised" Color="#FF16212C" />
  <SolidColorBrush x:Key="HmiWell" Color="#FF05080C" />
  <SolidColorBrush x:Key="HmiLine" Color="#FF20303E" />
  <SolidColorBrush x:Key="HmiLineStrong" Color="#FF33506A" />

  <!-- Text. -->
  <SolidColorBrush x:Key="HmiText" Color="#FFD6E4F0" />
  <SolidColorBrush x:Key="HmiMuted" Color="#FF74889C" />
  <SolidColorBrush x:Key="HmiFaint" Color="#FF3C4C5C" />

  <!-- Industrial semantics: cyan accent, amber warning, red danger, green normal. -->
  <SolidColorBrush x:Key="HmiAccent" Color="#FF25D0EC" />
  <SolidColorBrush x:Key="HmiAccentDim" Color="#FF11707F" />
  <SolidColorBrush x:Key="HmiAccentGlow" Color="#3325D0EC" />
  <SolidColorBrush x:Key="HmiAmber" Color="#FFFFB020" />
  <SolidColorBrush x:Key="HmiAmberDim" Color="#66FFB020" />
  <SolidColorBrush x:Key="HmiDanger" Color="#FFFF3B4E" />
  <SolidColorBrush x:Key="HmiDangerDim" Color="#66FF3B4E" />
  <SolidColorBrush x:Key="HmiNormal" Color="#FF32E0A2" />
  <SolidColorBrush x:Key="HmiNormalDim" Color="#5532E0A2" />
  <SolidColorBrush x:Key="HmiSteel" Color="#FF8FA6BA" />
  <SolidColorBrush x:Key="HmiGrid" Color="#1A25D0EC" />

  <!-- A faint vertical scan-line wash used on the wall panels. -->
  <LinearGradientBrush x:Key="HmiPanelSheen" StartPoint="0,0" EndPoint="0,1">
    <LinearGradientBrush.GradientStops>
      <GradientStop Color="#1A25D0EC" Offset="0" />
      <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
</ResourceDictionary>
