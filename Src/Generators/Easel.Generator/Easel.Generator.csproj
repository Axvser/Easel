<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<TargetFramework>netstandard2.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageId>WinForms.Easel.Generator</PackageId>
		<Title>Easel.Generator</Title>
		<Version>2.0.0</Version>
		<Authors>Axvser</Authors>
		<Description>XAML compiler and dependency-property source generators for Easel.</Description>
		<PackageIcon>easel-logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>xaml;winforms;source-generator;dependency-property</PackageTags>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/Axvser/Easel</RepositoryUrl>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<AnalyzerLanguage>cs</AnalyzerLanguage>
		<!-- NU5128: analyzer-only packages intentionally have no lib folder -->
		<NoWarn>$(NoWarn);NU5128</NoWarn>
	</PropertyGroup>

	<!-- Roslyn 4.8 keeps the generator loadable by the .NET 8 compiler. -->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
		<AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\..\Assets\easel-logo.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\..\Assets\easel-logo.png" Pack="true" PackagePath="Assets\" Visible="false" />
		<None Include="..\..\..\Assets\gallery-dashboard.png" Pack="true" PackagePath="Assets\" Visible="false" />
		<None Include="..\..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<!-- Pack into the analyzers folder; IncludeBuildOutput=false keeps the Roslyn DLLs out of lib. -->
	<ItemGroup>
		<None Include="bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
	</ItemGroup>

</Project>
