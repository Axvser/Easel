<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="TemplateClass.MainForm"
    Title="MainForm"
    Width="1200"
    Height="800"
    StartPosition="CenterScreen">

  <!-- Easel customization: replace this content. The window owns one visual tree; Width/Height are DIPs. -->
  <StackPanel Margin="24" Spacing="8">
    <TextBlock Text="MainForm" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Text="Compose the window content in XAML. App starts it through Application.Run."
               Wrap="True" />
  </StackPanel>

</Window>
