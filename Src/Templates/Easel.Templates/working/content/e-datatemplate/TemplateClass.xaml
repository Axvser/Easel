<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="TemplateNamespace.TemplateClass">

  <!-- Easel customization: bind the item members; use the key from ItemsControl.ItemTemplate,
       ListBox.ItemTemplate or DataGridColumn.CellTemplate. -->
  <DataTemplate x:Key="ItemRow">
    <StackPanel Spacing="2">
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Detail}" FontSize="9" />
    </StackPanel>
  </DataTemplate>

</ResourceDictionary>
