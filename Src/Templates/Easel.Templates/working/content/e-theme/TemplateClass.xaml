<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="TemplateNamespace.TemplateClass">

  <!-- Partial theme overlay. Merge this dictionary AFTER the host's built-in Dark/Light dictionary:
       only the keys below override it; every other palette/metric/style key keeps falling back to the theme.
       There is no ResourceDictionary.BasedOn in Easel: append the dictionary to
       VisualHost.Resources.MergedDictionaries (or a view's Resources) after the theme. -->
  <SolidColorBrush x:Key="Accent" Color="#FF4C8DFF" />
  <SolidColorBrush x:Key="Focus" Color="#FF7FB0FF" />
  <SolidColorBrush x:Key="Caret" Color="#FF7FB0FF" />
  <SolidColorBrush x:Key="Selection" Color="#FF1B355C" />

  <x:String x:Key="FontFamily">Segoe UI</x:String>

  <!-- Style inheritance uses BasedOn; the base and derived styles live in this dictionary. -->
  <Style x:Key="Body" TargetType="TextBlock">
    <Style.Setters>
      <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style.Setters>
  </Style>
  <Style x:Key="Subheading" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Style.Setters>
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style.Setters>
  </Style>
  <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Subheading}">
    <Style.Setters>
      <Setter Property="FontSize" Value="19" />
    </Style.Setters>
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Body}">
    <Style.Setters>
      <Setter Property="FontSize" Value="9" />
      <Setter Property="Opacity" Value="0.65" />
    </Style.Setters>
  </Style>

</ResourceDictionary>
