<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="TemplateNamespace.TemplateClass">

  <!-- Easel customization: derive one keyed style from a local base with BasedOn.
       Request it with Style="{StaticResource Emphasized}". -->
  <Style x:Key="BaseText" TargetType="TextBlock">
    <Style.Setters>
      <Setter Property="FontSize" Value="10" />
    </Style.Setters>
  </Style>
  <Style x:Key="Emphasized" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
    <Style.Setters>
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#FF4C8DFF" />
    </Style.Setters>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Trigger.Setters>
          <Setter Property="Foreground" Value="#FF55555F" />
        </Trigger.Setters>
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
