<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<PackageId>WinForms.Easel.Templates</PackageId>
		<Version>1.4.0</Version>
		<Title>Easel templates</Title>
		<Authors>Axvser</Authors>
		<Description>Item templates for Easel XAML views and resource dictionaries.</Description>
		<PackageTags>dotnet-new;templates;easel;winforms;xaml</PackageTags>
		<PackageType>Template</PackageType>
		<PackageIcon>easel-logo.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/Axvser/Easel</RepositoryUrl>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<IncludeContentInPack>true</IncludeContentInPack>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<EnableDefaultNoneItems>false</EnableDefaultNoneItems>
		<NoDefaultExcludes>true</NoDefaultExcludes>
		<NoWarn>$(NoWarn);NU5128</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Include="content\**\*" Pack="true" PackagePath="content" />
		<None Include="..\..\..\..\Assets\easel-logo.png" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

</Project>
