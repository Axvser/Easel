<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Easel.Test.Fixtures.WindowView"
    Title="Window fixture"
    Width="420"
    Height="260">

  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#FF0078D4" />
  </Window.Resources>

  <StackPanel x:Name="layoutRoot" Spacing="8">
    <TextBlock x:Name="greetingText" Text="{Binding Greeting}" />
  </StackPanel>
</Window>
