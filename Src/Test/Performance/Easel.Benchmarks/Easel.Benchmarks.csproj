<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone performance runner. It is intentionally not in Easel.slnx and is never packed:
       it references the runtime project only to measure it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <EaselProject Condition="'$(EaselProject)' == ''">../../../Easel/Easel.csproj</EaselProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(EaselProject)" />
  </ItemGroup>
</Project>
