<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Easel.Themes.Defaults.ButtonDefaults">

  <!-- Built-in fallback appearance for Button family; added to the implicit style table by Theme.DefaultStyles. -->
<Style TargetType="Button">
    <Style.Template>
      <ControlTemplate TargetType="Button">
        <Grid x:Name="Root" IsHitTestVisible="False">
          <Border x:Name="Chrome"
                  IsHitTestVisible="False"
                  Background="{DynamicResource Input}"
                  BorderBrush="{DynamicResource Border}"
                  BorderThickness="1"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <Border x:Name="Hover"
                  IsHitTestVisible="False"
                  Background="{DynamicResource Hover}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <Border x:Name="Pressed"
                  IsHitTestVisible="False"
                  Background="{DynamicResource Pressed}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <Border IsHitTestVisible="False"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <Border x:Name="FocusRing"
                  IsHitTestVisible="False"
                  BorderBrush="{DynamicResource Focus}"
                  BorderThickness="1.5"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <Border IsHitTestVisible="False" Padding="{TemplateBinding Padding}">
            <TextBlock IsHitTestVisible="False"
                       Text="{TemplateBinding Text}"
                       Font="{TemplateBinding Font}"
                       Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsPointerOver" Value="True">
            <Trigger.Setters>
              <Setter TargetName="Hover" Property="Opacity" Value="1" />
            </Trigger.Setters>
          </Trigger>
          <Trigger Property="IsPointerOver" Value="False">
            <Trigger.Setters>
              <Setter TargetName="Hover" Property="Opacity" Value="0" />
            </Trigger.Setters>
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Trigger.Setters>
              <Setter TargetName="Pressed" Property="Opacity" Value="1" />
            </Trigger.Setters>
          </Trigger>
          <Trigger Property="IsPressed" Value="False">
            <Trigger.Setters>
              <Setter TargetName="Pressed" Property="Opacity" Value="0" />
            </Trigger.Setters>
          </Trigger>
          <Trigger Property="IsFocusVisible" Value="True">
            <Trigger.Setters>
              <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
            </Trigger.Setters>
          </Trigger>
          <Trigger Property="IsFocusVisible" Value="False">
            <Trigger.Setters>
              <Setter TargetName="FocusRing" Property="Opacity" Value="0" />
            </Trigger.Setters>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Trigger.Setters>
              <Setter TargetName="Root" Property="Opacity" Value="0.55" />
            </Trigger.Setters>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Style.Template>
  </Style>

</ResourceDictionary>
