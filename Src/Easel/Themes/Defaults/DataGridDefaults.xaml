<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Easel.Themes.Defaults.DataGridDefaults">

  <!-- Built-in fallback appearance for DataGrid; added to the implicit style table by Theme.DefaultStyles.
       The shell template only declares the layout regions: the grid still paints rows, cells and headers itself,
       so every part stays transparent and out of hit testing. -->
<Style TargetType="DataGrid">
    <Style.Setters>
      <Setter Property="CellPadding" Value="10" />
      <Setter Property="HeaderPadding" Value="10" />
      <Setter Property="ColumnHeaderFontStyle" Value="Bold" />
      <Setter Property="BadgeHeight" Value="20" />
      <Setter Property="BadgePadding" Value="9" />
      <Setter Property="CheckSize" Value="16" />
      <Setter Property="CheckCornerRadius" Value="4" />
      <Setter Property="ProgressTrackHeight" Value="6" />
      <Setter Property="ProgressCornerRadius" Value="3" />
    </Style.Setters>
    <Style.Template>
      <ControlTemplate TargetType="DataGrid">
        <Grid IsHitTestVisible="False">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border x:Name="PART_ColumnHeaders"
                  Grid.Row="0"
                  Grid.ColumnSpan="2"
                  Height="{TemplateBinding HeaderHeight}"
                  IsHitTestVisible="False" />
          <Border x:Name="PART_Rows"
                  Grid.Row="1"
                  Grid.Column="0"
                  IsHitTestVisible="False" />
          <Border x:Name="PART_CellHost"
                  Grid.Row="1"
                  Grid.Column="0"
                  IsHitTestVisible="False" />
          <Border x:Name="PART_ScrollBar"
                  Grid.Row="1"
                  Grid.Column="1"
                  Width="12"
                  IsHitTestVisible="False" />
          <Border x:Name="PART_Corner"
                  Grid.Row="0"
                  Grid.Column="1"
                  Width="12"
                  IsHitTestVisible="False" />
        </Grid>
      </ControlTemplate>
    </Style.Template>
  </Style>

</ResourceDictionary>
