<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Easel.Themes.Defaults.RangeDefaults">

  <!-- Built-in fallback appearance for Slider and ProgressBar; added to the implicit style table by Theme.DefaultStyles. -->
<Style TargetType="Slider">
    <Style.Template>
      <ControlTemplate TargetType="Slider">
        <SliderChrome x:Name="PART_Chrome"
                      IsHitTestVisible="False"
                      TrackBrush="{TemplateBinding TrackBrush}"
                      FillBrush="{TemplateBinding FillBrush}"
                      ThumbBrush="{TemplateBinding ThumbBrush}"
                      FocusRingBrush="{TemplateBinding FocusRingBrush}"
                      ShowFocusRing="{TemplateBinding IsFocusVisible}" />
        <ControlTemplate.Triggers>
          <Trigger Property="IsEnabled" Value="False">
            <Trigger.Setters>
              <Setter TargetName="PART_Chrome" Property="Opacity" Value="0.55" />
            </Trigger.Setters>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Style.Template>
  </Style>

<Style TargetType="ProgressBar">
    <Style.Template>
      <ControlTemplate TargetType="ProgressBar">
        <ProgressBarChrome x:Name="PART_Chrome"
                           IsHitTestVisible="False"
                           TrackBrush="{TemplateBinding TrackBrush}"
                           FillBrush="{TemplateBinding FillBrush}"
                           CornerRadius="{TemplateBinding CornerRadius}" />
      </ControlTemplate>
    </Style.Template>
  </Style>

</ResourceDictionary>
