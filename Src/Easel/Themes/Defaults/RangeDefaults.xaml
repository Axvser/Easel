<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Easel.Themes.Defaults.RangeDefaults">

  <!-- Built-in fallback appearance for Slider and ProgressBar; added to the implicit style table by Theme.DefaultStyles. -->
<Style TargetType="Slider">
    <Style.Template>
      <ControlTemplate TargetType="Slider">
        <Grid x:Name="Root" IsHitTestVisible="False">
          <Border x:Name="PART_Track"
                  IsHitTestVisible="False"
                  Height="4"
                  Margin="7,0,7,0"
                  VerticalAlignment="Center"
                  Background="{DynamicResource SurfaceAlt}"
                  CornerRadius="2" />
          <Border x:Name="PART_Fill"
                  IsHitTestVisible="False"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource Accent}"
                  CornerRadius="2" />
          <Ellipse x:Name="PART_Thumb"
                   IsHitTestVisible="False"
                   Width="14"
                   Height="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Fill="{DynamicResource Accent}" />
          <Ellipse x:Name="PART_FocusRing"
                   IsHitTestVisible="False"
                   Width="18"
                   Height="18"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Stroke="{DynamicResource Focus}"
                   StrokeThickness="1.4" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsFocusVisible" Value="True">
            <Trigger.Setters>
              <Setter TargetName="PART_FocusRing" Property="Opacity" Value="1" />
            </Trigger.Setters>
          </Trigger>
          <Trigger Property="IsFocusVisible" Value="False">
            <Trigger.Setters>
              <Setter TargetName="PART_FocusRing" Property="Opacity" Value="0" />
            </Trigger.Setters>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Trigger.Setters>
              <Setter TargetName="Root" Property="Opacity" Value="0.55" />
            </Trigger.Setters>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Style.Template>
  </Style>

<Style TargetType="ProgressBar">
    <Style.Template>
      <ControlTemplate TargetType="ProgressBar">
        <Grid IsHitTestVisible="False">
          <Border x:Name="PART_Track"
                  IsHitTestVisible="False"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource SurfaceAlt}"
                  CornerRadius="999" />
          <Border x:Name="PART_Fill"
                  IsHitTestVisible="False"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource Accent}"
                  CornerRadius="999" />
        </Grid>
      </ControlTemplate>
    </Style.Template>
  </Style>

</ResourceDictionary>
