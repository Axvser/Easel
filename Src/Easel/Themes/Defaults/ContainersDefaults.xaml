<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Easel.Themes.Defaults.ContainersDefaults">

  <!-- Built-in fallback appearance for Expander, GroupBox, TabControl and TabItem; added to the implicit style table by Theme.DefaultStyles. -->

  <Style TargetType="Expander">
    <Style.Template>
      <ControlTemplate TargetType="Expander">
        <Grid IsHitTestVisible="False">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Grid.RowSpan="2"
                  IsHitTestVisible="False"
                  Background="{TemplateBinding ChromeBackground}"
                  BorderBrush="{TemplateBinding ChromeBorderBrush}"
                  BorderThickness="{TemplateBinding ChromeBorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <Border x:Name="PART_Header"
                  Grid.Row="0"
                  IsHitTestVisible="False"
                  Height="32"
                  Padding="0"
                  Background="{TemplateBinding HeaderBackground}"
                  BorderBrush="{TemplateBinding HeaderBorderBrush}"
                  BorderThickness="{TemplateBinding HeaderBorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        Padding="12,0"
                        IsHitTestVisible="False">
              <TextBlock x:Name="PART_Toggle"
                         Text="▸"
                         Opacity="0.65"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False" />
              <TextBlock Text="{TemplateBinding Header}"
                         Foreground="{TemplateBinding HeaderForeground}"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False" />
            </StackPanel>
          </Border>
          <Grid x:Name="PART_ContentHost"
                Grid.Row="1"
                Padding="{TemplateBinding Padding}"
                IsHitTestVisible="False" />
        </Grid>
      </ControlTemplate>
    </Style.Template>
  </Style>

  <Style TargetType="GroupBox">
    <Style.Template>
      <ControlTemplate TargetType="GroupBox">
        <Grid IsHitTestVisible="False">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border IsHitTestVisible="False"
                  Padding="0"
                  Background="{TemplateBinding ChromeBackground}"
                  BorderBrush="{TemplateBinding ChromeBorderBrush}"
                  BorderThickness="{TemplateBinding ChromeBorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <Border x:Name="PART_Header"
                  IsHitTestVisible="False"
                  Margin="8,0,0,0"
                  Padding="4,0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Background="{TemplateBinding HeaderBackground}"
                  BorderBrush="{TemplateBinding HeaderBorderBrush}"
                  BorderThickness="{TemplateBinding HeaderBorderThickness}">
            <TextBlock Text="{TemplateBinding Header}"
                       Foreground="{TemplateBinding HeaderForeground}"
                       IsHitTestVisible="False" />
          </Border>
          <StackPanel x:Name="PART_ContentHost"
                      Margin="0,14,0,0"
                      Padding="{TemplateBinding Padding}"
                      IsHitTestVisible="False" />
        </Grid>
      </ControlTemplate>
    </Style.Template>
  </Style>

  <!-- The header container seam: the keyed style carries the whole tab-header template, and the exact-type
       implicit style below applies it. A host replaces the header look by supplying its own TabItem style; the
       tab control only pushes IsSelected / IsPointerOver / IsFocusVisible onto these containers. -->
  <Style x:Key="TabItemContainerStyle" TargetType="TabItem">
    <Style.Setters>
      <Setter Property="Padding" Value="14,0" />
    </Style.Setters>
    <Style.Template>
      <ControlTemplate TargetType="TabItem">
        <Grid Height="32" IsHitTestVisible="False">
          <Border IsHitTestVisible="False"
                  Background="{TemplateBinding ChromeBackground}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <Border x:Name="HoverBand"
                  IsHitTestVisible="False"
                  Background="{DynamicResource Hover}" />
          <Border x:Name="SelectionFill"
                  IsHitTestVisible="False"
                  Background="{DynamicResource Raised}" />
          <Border x:Name="SelectionLine"
                  IsHitTestVisible="False"
                  Height="2"
                  VerticalAlignment="Bottom"
                  Background="{TemplateBinding SelectionLineBrush}" />
          <Border x:Name="ChromeBorder"
                  IsHitTestVisible="False"
                  BorderBrush="{TemplateBinding ChromeBorderBrush}"
                  BorderThickness="{TemplateBinding ChromeBorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <Border x:Name="FocusRing"
                  IsHitTestVisible="False"
                  Margin="1"
                  BorderBrush="{DynamicResource Focus}"
                  BorderThickness="1.5"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <TextBlock x:Name="MutedLabel"
                     Text="{TemplateBinding Header}"
                     Foreground="{TemplateBinding HeaderForeground}"
                     Padding="{TemplateBinding Padding}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False" />
          <TextBlock x:Name="SelectedLabel"
                     Text="{TemplateBinding Header}"
                     Foreground="{TemplateBinding HeaderForeground}"
                     Padding="{TemplateBinding Padding}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="False">
            <Trigger.Setters>
              <Setter TargetName="SelectionFill" Property="Opacity" Value="0" />
              <Setter TargetName="SelectionLine" Property="Opacity" Value="0" />
              <Setter TargetName="MutedLabel" Property="Opacity" Value="0.65" />
              <Setter TargetName="SelectedLabel" Property="Opacity" Value="0" />
            </Trigger.Setters>
          </Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Trigger.Setters>
              <Setter TargetName="SelectionFill" Property="Opacity" Value="1" />
              <Setter TargetName="SelectionLine" Property="Opacity" Value="1" />
              <Setter TargetName="MutedLabel" Property="Opacity" Value="0" />
              <Setter TargetName="SelectedLabel" Property="Opacity" Value="1" />
            </Trigger.Setters>
          </Trigger>
          <Trigger Property="IsPointerOver" Value="False">
            <Trigger.Setters>
              <Setter TargetName="HoverBand" Property="Opacity" Value="0" />
            </Trigger.Setters>
          </Trigger>
          <Trigger Property="IsPointerOver" Value="True">
            <Trigger.Setters>
              <Setter TargetName="HoverBand" Property="Opacity" Value="1" />
            </Trigger.Setters>
          </Trigger>
          <Trigger Property="IsFocusVisible" Value="False">
            <Trigger.Setters>
              <Setter TargetName="FocusRing" Property="Opacity" Value="0" />
            </Trigger.Setters>
          </Trigger>
          <Trigger Property="IsFocusVisible" Value="True">
            <Trigger.Setters>
              <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
            </Trigger.Setters>
          </Trigger>
          <Trigger Property="IsEnabled" Value="True">
            <Trigger.Setters>
              <Setter Property="Opacity" Value="1" />
            </Trigger.Setters>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Trigger.Setters>
              <Setter Property="Opacity" Value="0.55" />
            </Trigger.Setters>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Style.Template>
  </Style>

  <Style TargetType="TabItem" BasedOn="{StaticResource TabItemContainerStyle}" />

  <Style TargetType="TabControl">
    <Style.Template>
      <ControlTemplate TargetType="TabControl">
        <Grid IsHitTestVisible="False">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.RowSpan="2"
                  IsHitTestVisible="False"
                  Background="{TemplateBinding ChromeBackground}"
                  BorderBrush="{TemplateBinding ChromeBorderBrush}"
                  BorderThickness="{TemplateBinding ChromeBorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <Grid Grid.Row="0" IsHitTestVisible="False">
            <StackPanel x:Name="PART_HeaderHost"
                        Orientation="Horizontal"
                        IsHitTestVisible="False" />
            <Border Height="1"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource Border}"
                    IsHitTestVisible="False" />
          </Grid>
          <Border Grid.Row="1" Padding="{TemplateBinding Padding}" IsHitTestVisible="False">
            <Grid x:Name="PART_ContentHost" IsHitTestVisible="False" />
          </Border>
        </Grid>
      </ControlTemplate>
    </Style.Template>
  </Style>

</ResourceDictionary>
