<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Easel.Themes.DarkTheme">

  <!-- The built-in Dark+ fallback palette, authored as a WPF-style ResourceDictionary. Every theme file repeats the typography
       styles on purpose so a theme can be read, compared and replaced on its own. -->
    <SolidColorBrush x:Key="Window" Color="#FF141414" />
    <SolidColorBrush x:Key="Surface" Color="#FF252526" />
    <SolidColorBrush x:Key="Raised" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="Input" Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="Border" Color="#FF333333" />
    <SolidColorBrush x:Key="Hover" Color="#FF303030" />
    <SolidColorBrush x:Key="Pressed" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="Text" Color="#FFE7E7E7" />
    <SolidColorBrush x:Key="Muted" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="Accent" Color="#FF0078D4" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Focus" Color="#FF0078D4" />
    <SolidColorBrush x:Key="Caret" Color="#FF0078D4" />
    <SolidColorBrush x:Key="Selection" Color="#FF094771" />
    <SolidColorBrush x:Key="SelectedText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Disabled" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="DisabledText" Color="#FF585858" />

    <SolidColorBrush x:Key="SurfaceAlt" Color="#FF2D2D2D" />

    <SolidColorBrush x:Key="ScrollBarThumb" Color="#66A0A0A0" />
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#CCE7E7E7" />
    <SolidColorBrush x:Key="ShapeStroke" Color="#885B8CFF" />
    <SolidColorBrush x:Key="ShadowColor" Color="#FF000000" />

    <x:String x:Key="FontFamily">Segoe UI</x:String>
    <x:Double x:Key="FontSize">9.5</x:Double>
    <x:FontWeight x:Key="FontWeight">Normal</x:FontWeight>

    <x:Double x:Key="CornerRadius">4</x:Double>
    <x:Int32 x:Key="ControlHeight">28</x:Int32>

    <x:Thickness x:Key="ControlBorderThickness">1</x:Thickness>
    <x:Double x:Key="FocusThickness">1.6</x:Double>
    <x:Double x:Key="FocusThicknessMedium">1.4</x:Double>
    <x:Double x:Key="FocusThicknessThin">1</x:Double>
    <x:Double x:Key="ScrollBarThumbRadius">3</x:Double>
    <x:Double x:Key="ShapeStrokeThickness">1.5</x:Double>
    <x:PointF x:Key="ShadowOffset">4,6</x:PointF>
    <x:Double x:Key="ShadowBlur">6</x:Double>
    <x:Double x:Key="ShadowOpacity">0.45</x:Double>

    <SolidColorBrush x:Key="TextVisualForeground" Color="#FFFFFFFF" />
    <x:String x:Key="TextVisualFontFamily">Segoe UI</x:String>
    <x:Double x:Key="TextVisualFontSize">9</x:Double>
    <x:FontWeight x:Key="TextVisualFontWeight">Normal</x:FontWeight>

    <Style x:Key="Body" TargetType="TextBlock">
      <Style.Setters>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Normal" />
      </Style.Setters>
    </Style>
    <Style x:Key="Subheading" TargetType="TextBlock" BasedOn="{StaticResource Body}">
      <Style.Setters>
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style.Setters>
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Subheading}">
      <Style.Setters>
        <Setter Property="FontSize" Value="19" />
      </Style.Setters>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource Body}">
      <Style.Setters>
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Opacity" Value="0.65" />
      </Style.Setters>
    </Style>

</ResourceDictionary>
