<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Easel.Themes.DefaultStyles">

  <!-- Built-in fallback styles for controls without an explicit style or template.
       Theme keys use DynamicResource so a host dictionary can override them. Decorative parts opt out of hit testing;
       the control itself stays the hit target. -->
  <Style TargetType="Button">
    <Style.Template>
      <ControlTemplate TargetType="Button">
        <Grid x:Name="Root" IsHitTestVisible="False">
          <Border x:Name="Chrome"
                  IsHitTestVisible="False"
                  Background="{DynamicResource Input}"
                  BorderBrush="{DynamicResource Border}"
                  BorderThickness="1"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <Border x:Name="Hover"
                  IsHitTestVisible="False"
                  Background="{DynamicResource Hover}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Opacity="0" />
          <Border x:Name="Pressed"
                  IsHitTestVisible="False"
                  Background="{DynamicResource Pressed}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Opacity="0" />
          <Border IsHitTestVisible="False"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <Border x:Name="FocusRing"
                  IsHitTestVisible="False"
                  BorderBrush="{DynamicResource Focus}"
                  BorderThickness="1.5"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Opacity="0" />
          <Border IsHitTestVisible="False" Padding="{TemplateBinding Padding}">
            <TextBlock IsHitTestVisible="False"
                       Text="{TemplateBinding Text}"
                       Font="{TemplateBinding Font}"
                       Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsPointerOver" Value="True">
            <Setter TargetName="Hover" Property="Opacity" Value="1" />
          </Trigger>
          <Trigger Property="IsPressed" Value="True">
            <Setter TargetName="Pressed" Property="Opacity" Value="1" />
          </Trigger>
          <Trigger Property="IsFocusVisible" Value="True">
            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="Root" Property="Opacity" Value="0.55" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Style.Template>
  </Style>

  <Style TargetType="RichTextBox">
    <Style.Template>
      <ControlTemplate TargetType="RichTextBox">
        <Grid>
          <Border Background="{DynamicResource Input}"
                  BorderBrush="{DynamicResource Border}"
                  BorderThickness="1"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <Border x:Name="FocusRing"
                  BorderBrush="{DynamicResource Focus}"
                  BorderThickness="1.5"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Opacity="0" />
          <Border Padding="{TemplateBinding Padding}">
            <RichTextContentHost x:Name="PART_ContentHost" IsHitTestVisible="False" />
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsFocused" Value="True">
            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Style.Template>
  </Style>

  <Style TargetType="TextBox">
    <Style.Template>
      <ControlTemplate TargetType="TextBox">
        <Grid>
          <Border Background="{DynamicResource Input}"
                  BorderBrush="{DynamicResource Border}"
                  BorderThickness="1"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <Border x:Name="FocusRing"
                  BorderBrush="{DynamicResource Focus}"
                  BorderThickness="1.5"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Opacity="0" />
          <Border Padding="{TemplateBinding Padding}">
            <TextBoxContentHost x:Name="PART_ContentHost" IsHitTestVisible="False" />
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsFocused" Value="True">
            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Style.Template>
  </Style>

</ResourceDictionary>
