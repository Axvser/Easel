<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:defaults="clr-namespace:Easel.Themes.Defaults"
    x:Class="Easel.Themes.DefaultStyles">

  <!-- Built-in fallback styles for controls without an explicit style or template.
       Theme keys use DynamicResource so a host dictionary can override them. Each group owns one dictionary so
       control families can evolve and be reviewed independently. -->
  <ResourceDictionary.MergedDictionaries>
    <defaults:ButtonDefaults />
    <defaults:TextInputDefaults />
    <defaults:ComboBoxDefaults />
    <defaults:ContainersDefaults />
    <defaults:RangeDefaults />
    <defaults:ItemsDefaults />
    <defaults:DataGridDefaults />
  </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
