<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Easel.Themes.LightTheme">

  <!-- The built-in Light+ fallback palette, authored as a WPF-style ResourceDictionary. The typography styles are intentionally repeated from DarkTheme.xaml: each theme
       file is a self-contained XAML resource set. -->
    <SolidColorBrush x:Key="Window" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Surface" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="Raised" Color="#FFDDDDDD" />
    <SolidColorBrush x:Key="Input" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Border" Color="#FFCECECE" />
    <SolidColorBrush x:Key="Hover" Color="#FFE8E8E8" />
    <SolidColorBrush x:Key="Pressed" Color="#FF0062A3" />
    <SolidColorBrush x:Key="Text" Color="#FF333333" />
    <SolidColorBrush x:Key="Muted" Color="#FF6F6F6F" />
    <SolidColorBrush x:Key="Accent" Color="#FF0078D4" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Focus" Color="#FF0090F1" />
    <SolidColorBrush x:Key="Selection" Color="#FFADD6FF" />
    <SolidColorBrush x:Key="SelectedText" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="Disabled" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="DisabledText" Color="#FFA0A0A0" />

    <SolidColorBrush x:Key="CardBackground" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="CardBorder" Color="#FFCECECE" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#FFDDDDDD" />
    <SolidColorBrush x:Key="MutedText" Color="#FF6F6F6F" />

    <SolidColorBrush x:Key="ScrollBarThumb" Color="#666F6F6F" />
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#CC333333" />
    <SolidColorBrush x:Key="ShapeStroke" Color="#885B8CFF" />
    <SolidColorBrush x:Key="ShadowColor" Color="#FF000000" />

    <x:String x:Key="FontFamily">Segoe UI</x:String>
    <x:Double x:Key="FontSize">9.5</x:Double>
    <x:FontWeight x:Key="FontWeight">Normal</x:FontWeight>

    <x:Double x:Key="CornerRadius">4</x:Double>
    <x:Int32 x:Key="ControlHeight">28</x:Int32>

    <x:Thickness x:Key="ControlBorderThickness">1</x:Thickness>
    <x:Double x:Key="FocusThickness">1.6</x:Double>
    <x:Double x:Key="FocusThicknessMedium">1.4</x:Double>
    <x:Double x:Key="FocusThicknessThin">1</x:Double>
    <x:Double x:Key="ScrollBarThumbRadius">3</x:Double>
    <x:Double x:Key="ShapeStrokeThickness">1.5</x:Double>
    <x:PointF x:Key="ShadowOffset">4,6</x:PointF>
    <x:Double x:Key="ShadowBlur">6</x:Double>
    <x:Double x:Key="ShadowOpacity">0.45</x:Double>

    <SolidColorBrush x:Key="TextVisualForeground" Color="#FFFFFFFF" />
    <x:String x:Key="TextVisualFontFamily">Segoe UI</x:String>
    <x:Double x:Key="TextVisualFontSize">9</x:Double>
    <x:FontWeight x:Key="TextVisualFontWeight">Normal</x:FontWeight>

    <Style x:Key="Heading" TargetType="TextBlock">
      <Style.Setters>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
      </Style.Setters>
    </Style>
    <Style x:Key="Subheading" TargetType="TextBlock">
      <Style.Setters>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
      </Style.Setters>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Style.Setters>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
      </Style.Setters>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Style.Setters>
        <Setter Property="FontFamily" Value="{StaticResource FontFamily}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
      </Style.Setters>
    </Style>

</ResourceDictionary>
