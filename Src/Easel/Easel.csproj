<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netframework4.6.1;net5.0-windows;netcoreapp3.0;net8.0-windows</TargetFrameworks>
		<EnableTrimAnalyzer Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</EnableTrimAnalyzer>
		<EnableAotAnalyzer Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</EnableAotAnalyzer>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<!-- WFO1000: the runtime's public designer properties are not designer-serialized.
		     IL2026/IL2075: the XAML layer intentionally uses TypeDescriptor/reflection for native properties. -->
		<NoWarn>$(NoWarn);WFO1000;IL2026;IL2059;IL2067;IL2075</NoWarn>
		<!-- The .NET Framework 4.6.1 and .NET Core 3.0 reference assemblies carry less nullable metadata;
		     the same code is warning-free on net5/net8. -->
		<NoWarn Condition="'$(TargetFramework)' == 'netframework4.6.1' Or '$(TargetFramework)' == 'netcoreapp3.0'">$(NoWarn);CS8600;CS8602;CS8603;CS8604</NoWarn>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageId>WinForms.Easel</PackageId>
		<Title>Easel</Title>
		<Version>1.2.0</Version>
		<Authors>Axvser</Authors>
		<Description>A XAML-first UI runtime for WinForms: dependency properties, a Roslyn XAML compiler, a WPF/Avalonia-shaped visual control library over a single HWND, and an injectable property-animation abstraction.</Description>
		<PackageIcon>easel-logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>winforms;xaml;ui;dependency-property</PackageTags>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/Axvser/Easel</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\Assets\easel-logo.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\Assets\easel-logo.png" Pack="true" PackagePath="Assets\" Visible="false" />
		<None Include="..\..\Assets\gallery-dashboard.png" Pack="true" PackagePath="Assets\" Visible="false" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- The XAML compiler compiles AdditionalFiles into InitializeComponent. -->
		<AdditionalFiles Include="**/*.xaml" />
	</ItemGroup>

	<!-- Debug 用本地生成器源码，Release 用 NuGet 上的包。 -->
	<ItemGroup>
		<ProjectReference Include="..\Generators\Easel.Generator\Easel.Generator.csproj"
		                  OutputItemType="Analyzer"
		                  ReferenceOutputAssembly="false"
		                  Condition="'$(Configuration)' == 'Debug'" />
		<PackageReference Include="WinForms.Easel.Generator" Version="1.2.0"
		                  Condition="'$(Configuration)' != 'Debug'" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netframework4.6.1'">
		<!-- net461 的引用程序集没有 ValueTuple；运行时与测试都用了元组。 -->
		<PackageReference Include="System.ValueTuple" Version="4.5.0" />
		<!-- CI runners may not carry the 4.6.1 targeting pack; the package supplies the reference assemblies. -->
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
	</ItemGroup>

</Project>
